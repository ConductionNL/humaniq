{
    "x-humaniq-fragment": "hr-survey",
    "components": {
        "schemas": {
            "Survey": {
                "slug": "Survey",
                "icon": "ClipboardTextOutline",
                "version": "0.1.0",
                "title": "Survey",
                "description": "An employee survey HR builds and sends to a group of employees: its questions, who it goes to, when it is open, and the minimum group size below which results are not shown (talent-engagement-surveys D1-D3).",
                "type": "object",
                "x-schema-org": "schema:CreativeWork",
                "required": [
                    "title",
                    "questions",
                    "scope",
                    "status"
                ],
                "authorization": {
                    "read": [
                        "humaniq-hr",
                        {
                            "group": "authenticated",
                            "match": {
                                "status": "open"
                            }
                        }
                    ],
                    "create": [
                        "humaniq-hr"
                    ],
                    "update": [
                        "humaniq-hr"
                    ],
                    "delete": [
                        "humaniq-hr"
                    ]
                },
                "configuration": {
                    "x-openregister-lifecycle": {
                        "field": "status",
                        "initial": "concept",
                        "terminal": [
                            "gesloten"
                        ],
                        "transitions": {
                            "openen": {
                                "from": [
                                    "concept"
                                ],
                                "to": "open",
                                "requires": "OCA\\Humaniq\\Lifecycle\\SurveyOpenGuard",
                                "description": "Open the survey. Only Open survey does this, because it invites the employees in scope in the same step."
                            },
                            "sluiten": {
                                "from": [
                                    "open"
                                ],
                                "to": "gesloten",
                                "description": "Close the survey. No answers are taken after this, and the results are final."
                            }
                        }
                    }
                },
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 200,
                        "title": "Title",
                        "description": "What the survey is about, such as Engagement survey autumn 2026."
                    },
                    "introduction": {
                        "type": "string",
                        "maxLength": 5000,
                        "nullable": true,
                        "title": "Introduction",
                        "description": "What employees read before the questions: why you ask, and that answers are anonymous."
                    },
                    "questions": {
                        "type": "array",
                        "title": "Questions",
                        "description": "The questions, in the order employees see them. A recommend question (0 to 10) gives the eNPS.",
                        "x-notes": "talent-engagement-surveys D1: the manifest fields[] shape {key, type, label, required, options} that CnFormBuilder edits; type scale (1 to 5, or options.min/max), enum (a choice, options is the list), textarea (free text) or recommend (0 to 10, the eNPS question).",
                        "items": {
                            "type": "object",
                            "required": [
                                "key",
                                "type",
                                "label"
                            ],
                            "properties": {
                                "key": {
                                    "type": "string",
                                    "title": "Key",
                                    "description": "The name the answers are stored under."
                                },
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "scale",
                                        "enum",
                                        "textarea",
                                        "recommend"
                                    ],
                                    "title": "Kind",
                                    "description": "A scale from 1 to 5, a choice, free text, or the 0 to 10 recommend question.",
                                    "x-enum-labels": {
                                        "scale": "Scale 1 to 5",
                                        "enum": "Choice",
                                        "textarea": "Free text",
                                        "recommend": "Would you recommend us"
                                    }
                                },
                                "label": {
                                    "type": "string",
                                    "title": "Question",
                                    "description": "The question as employees read it."
                                },
                                "required": {
                                    "type": "boolean",
                                    "title": "Required",
                                    "description": "Whether the question must be answered."
                                },
                                "options": {
                                    "title": "Options",
                                    "description": "The choices of a choice question, or the lowest and highest value of a scale.",
                                    "oneOf": [
                                        {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        {
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "scope": {
                        "type": "string",
                        "enum": [
                            "everyone",
                            "orgUnits",
                            "contractType"
                        ],
                        "default": "everyone",
                        "title": "Sent to",
                        "description": "Everyone in the administration, the departments you choose, or one contract type.",
                        "x-enum-labels": {
                            "everyone": "Everyone",
                            "orgUnits": "Chosen departments",
                            "contractType": "One contract type"
                        }
                    },
                    "orgUnitIds": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "uuid",
                            "$ref": "OrgUnit"
                        },
                        "default": [],
                        "title": "Departments",
                        "description": "The departments it goes to, including their teams. Only used when it is sent to chosen departments."
                    },
                    "contractType": {
                        "type": "string",
                        "nullable": true,
                        "title": "Contract type",
                        "description": "The contract type it goes to, such as permanent. Only used when it is sent to one contract type."
                    },
                    "opensOn": {
                        "type": "string",
                        "format": "date",
                        "nullable": true,
                        "title": "Opens on",
                        "description": "The first day employees can answer."
                    },
                    "closesOn": {
                        "type": "string",
                        "format": "date",
                        "nullable": true,
                        "title": "Closes on",
                        "description": "The last day employees can answer. Employees who have not answered get a reminder in the three days before."
                    },
                    "minGroupSize": {
                        "type": "integer",
                        "minimum": 3,
                        "default": 5,
                        "title": "Minimum group size",
                        "description": "A department with fewer answers than this is not shown on its own in the results, so nobody can be recognised."
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "concept",
                            "open",
                            "gesloten"
                        ],
                        "default": "concept",
                        "title": "Status",
                        "description": "Draft, open for answers, or closed.",
                        "x-enum-labels": {
                            "concept": "Draft",
                            "open": "Open",
                            "gesloten": "Closed"
                        },
                        "x-notes": "Open is set by POST /api/surveys/{id}/open, which also creates the invitations (D2); the openen transition's guard refuses every other way. Close is the sluiten transition."
                    },
                    "invitedCount": {
                        "type": "integer",
                        "default": 0,
                        "title": "Invited",
                        "description": "How many employees were invited when the survey opened."
                    },
                    "withoutAccountCount": {
                        "type": "integer",
                        "default": 0,
                        "title": "Not invited, no account",
                        "description": "Employees in scope without a Nextcloud account, who could not be invited."
                    },
                    "administrationId": {
                        "type": "string",
                        "nullable": true,
                        "title": "Administration",
                        "description": "The administration whose employees it is for."
                    }
                }
            },
            "SurveyInvitation": {
                "slug": "SurveyInvitation",
                "icon": "EmailOutline",
                "version": "0.1.0",
                "title": "Survey invitation",
                "description": "One employee's invitation to a survey. It records only whether the employee answered, never what (talent-engagement-surveys D1).",
                "type": "object",
                "required": [
                    "surveyId",
                    "employeeId",
                    "status"
                ],
                "authorization": {
                    "read": [
                        "humaniq-hr",
                        {
                            "group": "authenticated",
                            "match": {
                                "userId": "$userId"
                            }
                        }
                    ],
                    "create": [
                        "humaniq-hr"
                    ],
                    "update": [
                        "humaniq-hr"
                    ],
                    "delete": [
                        "humaniq-hr"
                    ]
                },
                "configuration": {
                    "x-openregister-notifications": {
                        "survey-invited": {
                            "trigger": {
                                "type": "created"
                            },
                            "enabled": true,
                            "originApp": "humaniq",
                            "channels": [
                                "nc-notification"
                            ],
                            "recipients": [
                                {
                                    "kind": "field",
                                    "field": "userId"
                                }
                            ],
                            "subject": {
                                "nl": "Je bent uitgenodigd voor een enquête",
                                "en": "You are invited to a survey"
                            },
                            "message": {
                                "nl": "Je vindt de enquête bij Mijn enquêtes. Je antwoorden zijn anoniem.",
                                "en": "You find the survey under My surveys. Your answers are anonymous."
                            },
                            "_note": "talent-engagement-surveys D2: the invited employee in userId hears it once, when the invitation is created."
                        },
                        "survey-reminder": {
                            "trigger": {
                                "type": "scheduled",
                                "intervalSec": 86400,
                                "filter": {
                                    "status": "open",
                                    "closesOn": {
                                        "operator": "withinNext",
                                        "value": "P3D"
                                    }
                                }
                            },
                            "enabled": true,
                            "originApp": "humaniq",
                            "channels": [
                                "nc-notification"
                            ],
                            "recipients": [
                                {
                                    "kind": "field",
                                    "field": "userId"
                                }
                            ],
                            "subject": {
                                "nl": "Herinnering: de enquête sluit bijna",
                                "en": "Reminder: the survey closes soon"
                            },
                            "message": {
                                "nl": "Je hebt de enquête nog niet ingevuld. Je vindt haar bij Mijn enquêtes.",
                                "en": "You have not answered the survey yet. You find it under My surveys."
                            },
                            "_note": "talent-engagement-surveys D2: daily in the three days before closesOn (copied onto the invitation so the filter can read it), only while the invitation is open."
                        }
                    }
                },
                "properties": {
                    "surveyId": {
                        "type": "string",
                        "format": "uuid",
                        "$ref": "Survey",
                        "title": "Survey",
                        "description": "The survey."
                    },
                    "employeeId": {
                        "type": "string",
                        "format": "uuid",
                        "$ref": "Employee",
                        "title": "Employee",
                        "description": "Who is invited."
                    },
                    "userId": {
                        "type": "string",
                        "nullable": true,
                        "title": "Employee account",
                        "description": "The employee's Nextcloud account, who gets the invitation and the reminder."
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "open",
                            "beantwoord"
                        ],
                        "default": "open",
                        "title": "Status",
                        "description": "Whether the employee has answered.",
                        "x-enum-labels": {
                            "open": "Not answered",
                            "beantwoord": "Answered"
                        }
                    },
                    "closesOn": {
                        "type": "string",
                        "format": "date",
                        "nullable": true,
                        "title": "Closes on",
                        "description": "The survey's last day, for the reminder.",
                        "x-notes": "Copied from the survey when the invitation is created; the reminder rule's withinNext filter reads it here."
                    },
                    "administrationId": {
                        "type": "string",
                        "nullable": true,
                        "title": "Administration",
                        "description": "The administration of the employee."
                    }
                }
            },
            "SurveyResponse": {
                "slug": "SurveyResponse",
                "icon": "CommentTextMultipleOutline",
                "version": "0.1.0",
                "title": "Survey response",
                "description": "One set of answers to a survey. It holds the department and contract type of whoever answered and the date, and nothing that names them: no employee, account, invitation or time of day (talent-engagement-surveys D1).",
                "type": "object",
                "required": [
                    "surveyId",
                    "answers",
                    "submittedOn"
                ],
                "authorization": {
                    "read": [
                        "humaniq-hr"
                    ],
                    "create": [
                        "humaniq-hr"
                    ],
                    "update": [
                        "humaniq-hr"
                    ],
                    "delete": [
                        "humaniq-hr"
                    ]
                },
                "properties": {
                    "surveyId": {
                        "type": "string",
                        "format": "uuid",
                        "$ref": "Survey",
                        "title": "Survey",
                        "description": "The survey answered."
                    },
                    "orgUnitId": {
                        "type": "string",
                        "nullable": true,
                        "title": "Department",
                        "description": "The department of whoever answered, on the day they answered."
                    },
                    "contractType": {
                        "type": "string",
                        "nullable": true,
                        "title": "Contract type",
                        "description": "The contract type of whoever answered."
                    },
                    "answers": {
                        "type": "object",
                        "title": "Answers",
                        "description": "The answers, by question key."
                    },
                    "submittedOn": {
                        "type": "string",
                        "format": "date",
                        "title": "Answered on",
                        "description": "The day of the answer, without the time."
                    },
                    "administrationId": {
                        "type": "string",
                        "nullable": true,
                        "title": "Administration",
                        "description": "The administration of the survey."
                    }
                }
            }
        },
