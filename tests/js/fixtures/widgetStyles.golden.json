				}
			},
			"@keyframes hq-hours-spin-golden": {
				"to": {
					"transform": "rotate(360deg)"
				}
			},
			"@media (prefers-reduced-motion: reduce)": {
				".hq-hours__spinner[data-v-golden]": {
					"animation-duration": "3s"
				}
			}
		}
	]
}
