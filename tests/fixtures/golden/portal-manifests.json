        "actions": [
            {
                "id": "applyToVacancy",
                "type": "create",
                "label": "Solliciteren",
                "register": "humaniq",
                "schema": "job-application",
                "anonymous": true,
                "minTrust": "low",
                "fields": [
                    "vacancyId",
                    "candidateName",
                    "email",
                    "phone",
                    "motivation",
                    "talentPoolOptIn",
                    "answers"
                ]
            }
        ],
        "notifications": [],
