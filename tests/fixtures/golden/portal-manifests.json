    "manager": {
        "label": "Werk en uren",
        "collections": [
            {
                "id": "teamTimesheets",
                "register": "humaniq",
                "schema": "Timesheet",
                "scopeField": "costCenter",
                "scopeClaim": "costCenter",
                "minTrust": "low",
                "label": "Urenstaten van uw team",
                "listable": true,
                "fields": [
                    "employeeId",
                    "period",
                    "hours",
                    "status",
                    "description"
                ],
                "columns": [
                    {
                        "field": "employeeId",
                        "label": "Medewerker"
                    },
                    {
                        "field": "period",
                        "label": "Periode"
                    },
                    {
                        "field": "hours",
                        "label": "Uren"
                    },
                    {
                        "field": "status",
                        "label": "Status",
                        "render": "badge"
                    }
                ],
                "detail": {
                    "layout": "card",
                    "fields": [
                        "employeeId",
                        "period",
                        "hours",
                        "status",
                        "description"
                    ]
                },
                "defaultSort": {
                    "field": "period",
                    "direction": "desc"
                }
            }
        ],
        "actions": [],
        "pages": [
            {
                "group": "Werk en uren",
                "id": "timesheets",
                "label": "Urenstaten van uw team",
