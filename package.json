{
  "name": "hrmq",
  "version": "0.1.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^22.14 || ^24 || >=26",
    "npm": "^11.0.0"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix",
    "stylelint": "stylelint \"src/**/*.{vue,scss,css}\"",
    "stylelint-fix": "stylelint src/**/*.vue src/**/*.scss src/**/*.css --fix",
    "check:manifest": "node tests/validate-manifest.js",
    "check:widget-keys": "node tests/validate-widget-keys.js",
    "check:deps-drift": "node scripts/check-node-deps-drift.js",
    "check:manifest-sentinels": "node scripts/check-manifest-sentinels.mjs",
    "check:bundle-freshness": "node scripts/check-bundle-freshness.js",
    "check:boot-integrity": "npm run check:deps-drift && npm run check:manifest-sentinels && npm run check:bundle-freshness",
    "test:e2e": "playwright test --project chromium"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@conduction/nextcloud-vue": "2.2.0-vue3.2",
    "@nextcloud/auth": "^2.5.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "@vueuse/core": "^14.3.0",
    "babel-loader": "^10.1.1",
    "dexie": "^4.4.5",
    "dompurify": "^3.0.0",
    "eslint-plugin-import": "^2.32.0",
    "gridstack": "^12.6.0",
    "marked": "^12.0.0",
    "node-polyfill-webpack-plugin": "4.0.0",
    "pinia": "^2.1.7",
    "terser-webpack-plugin": "^5.6.1",
    "vue": "^3.5.13",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "@noble/hashes": "1.4.0"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.4.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@playwright/test": "^1.59.1",
    "@nextcloud/eslint-config": "^8.4.2",
    "@nextcloud/eslint-plugin": "^2.2.1",
    "@nextcloud/stylelint-config": "^2.4.0",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "@vue/compiler-sfc": "^3.5.13",
    "axe-core": "^4.13.0",
    "css-loader": "~7.1.1",
    "eslint": "^8.56.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-vue": "^9.21.1",
    "jsdom": "^29.1.1",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "style-loader": "~4.0.0",
    "stylelint": "^15.11.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-loader": "^17.4.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1"
  }
}
