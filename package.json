    "@nextcloud/webpack-vue-config": "^6.0.1",
    "css-loader": "~7.1.1",
    "eslint": "^8.56.0",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "style-loader": "~4.0.0",
    "stylelint": "^15.11.0",
    "vue-loader": "^15.11.1",
