{
  "name": "humaniq",
  "version": "0.1.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^22.14 || ^24 || >=26",
    "npm": "^11.0.0"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "postbuild": "node -e \"require('fs').writeFileSync('js/.build-stamp', new Date().toISOString()+'\\n')\" && node scripts/write-build-info.js && node scripts/check-bundle-freshness.js --sidecar",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src tests scripts",
    "lint-fix": "npm run lint -- --fix",
    "stylelint": "stylelint \"src/**/*.{vue,scss,css}\"",
    "stylelint-fix": "stylelint src/**/*.vue src/**/*.scss src/**/*.css --fix",
    "check:schema-l10n": "node scripts/check-schema-l10n.js",
    "check:manifest": "node tests/validate-manifest.js",
    "check:manifest-parity": "node tests/verify-manifest-parity.js",
    "check:widget-keys": "node tests/validate-widget-keys.js",
    "check:leaf-parity": "bash scripts/check-integration-parity.sh",
    "check:seed-refs": "node tests/validate-seed-refs.js",
    "check:l10n": "node tests/validate-l10n-parity.js",
    "l10n:build": "node scripts/build-l10n-js.js",
    "check:l10n-js": "node scripts/build-l10n-js.js --check",
    "check:deps-drift": "node scripts/check-node-deps-drift.js",
    "check:manifest-sentinels": "node scripts/check-manifest-sentinels.mjs",
    "check:bundle-freshness": "node scripts/check-bundle-freshness.js",
    "check:boot-integrity": "npm run check:deps-drift && npm run check:manifest-sentinels && npm run check:bundle-freshness",
    "test:e2e": "playwright test --project chromium",
    "check:bundle-sidecar": "node scripts/check-bundle-freshness.js --sidecar"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@conduction/nextcloud-vue": "^2.40.0",
    "@nextcloud/auth": "^2.5.0",
    "@nextcloud/axios": "~2.6.0",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.11.0",
    "@vueuse/core": "^14.3.0",
    "babel-loader": "^10.1.1",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.15",
    "gridstack": "^13.3.0",
    "marked": "^18.0.11",
    "node-polyfill-webpack-plugin": "4.0.0",
    "pinia": "^3.0.4",
    "terser-webpack-plugin": "^5.6.1",
    "vue": "^3.5.42",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^5.3.1"
  },
  "overrides": {
    "@noble/hashes": "1.4.0"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/webpack-vue-config": "^7.0.4",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vue/compiler-sfc": "^3.5.13",
    "axe-core": "^4.13.0",
    "css-loader": "~7.1.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "style-loader": "~4.0.0",
    "stylelint": "^17.15.0",
    "vue-eslint-parser": "^10.3.0",
    "vue-loader": "^17.4.2",
    "webpack": "^5.111.0",
    "webpack-cli": "^6.0.1"
  }
}
