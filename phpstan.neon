# hrmq — Conduction PHPStan config.
#
# The shared base is the single source of truth. Everything here is either this
# app's own tracked debt or an ignore naming a symbol that exists in no other
# fleet app. Anything you are tempted to add that another app would also need
# belongs in the base, not here.
#
# What moved OUT of this file and into the base, verbatim and unchanged:
# level, paths, bootstrapFiles, scanDirectories, reportUnmatchedIgnoredErrors,
# and every \OC / OC\ / OCA\DAV\ / OCA\OpenRegister\ ignore. They were not
# hrmq-specific; all 18 apps had re-typed copies of the same blocks.
includes:
    - vendor/conduction/hydra-gates/quality-config/phpstan-base.neon
    # Tracked lint debt in the current tree. Not regenerated wholesale; entries
    # are removed one at a time as the underlying code is fixed.
    - phpstan-baseline.neon

parameters:
    # App-specific only.
    treatPhpDocTypesAsCertain: false

    excludePaths:
        # These guards implement OCA\OpenRegister\Lifecycle\LifecycleGuardInterface,
        # which only exists at runtime once OpenRegister is installed alongside
        # hrmq. PHPStan cannot baseline "implements unknown interface" errors —
        # exclusion is required, not preferred.
        - lib/Lifecycle/CompEffectiveDateGuard.php
        - lib/Lifecycle/LeaveBuySellApprovalGuard.php
        - lib/Lifecycle/LeaveSettlementPeriodGuard.php
        - lib/Lifecycle/NoSelfApprovalGuard.php
        - lib/Lifecycle/PayrollRunApprovedGuard.php

    ignoreErrors:
        # AuthorizedAdminSetting's constructor is typed
        # `class-string<IDelegatedSettings>`, but hrmq registers no settings
        # class, and adding one purely to satisfy a type would put a settings
        # PANEL in front of users as a side effect of an annotation.
        #
        # Passing the app id is the fleet's established form — 50 call sites
        # across openconnector, launchpad and others — and it fails CLOSED:
        # SecurityMiddleware resolves the value against the delegated-settings
        # registry, finds no delegation for it, and falls back to requiring a
        # full administrator. That is exactly the intended access rule for
        # `POST /api/payroll/packs`, and the controller's own isAdmin() check
        # remains as defence in depth.
        #
        # Scoped to this one attribute so any OTHER misuse still fails.
        -
            message: '#Parameter \#1 \$settings of attribute class OCP\\AppFramework\\Http\\Attribute\\AuthorizedAdminSetting constructor expects class-string<OCP\\Settings\\IDelegatedSettings>, string given#'
            path: lib/Controller/JurisdictionPackController.php

        # DocuDesk is an optional runtime companion app — hrmq's document
        # generation and receipt-OCR commands duck-type against it and no-op
        # when it is absent. No other fleet app analyses against DocuDesk, so
        # these stay local rather than going into the base.
        - '#unknown class OCA\\DocuDesk\\#'
        - '#OCA\\DocuDesk\\[a-zA-Z\\]+.*not found#'
        - '#on an unknown class OCA\\DocuDesk\\#'
