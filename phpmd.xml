<?xml version="1.0"?>
<ruleset name="humaniq"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset_xml_schema.xsd">
    <description>humaniq — Conduction PHPMD ruleset (single source: conduction/hydra-gates).</description>

    <!-- This was a ~40-rule hand-maintained copy of the fleet ruleset. Every rule
         it named, and both property overrides it carried (ShortVariable's
         minimum/exceptions list and DevelopmentCodeFragment's ignore-namespaces),
         are byte-identical to the central file — which is exactly how a fleet
         ends up with several drifting variants of one config. Only the two real
         divergences survive, declared AS divergences so they read as decisions
         rather than hiding inside a full copy. -->
    <rule ref="vendor/conduction/hydra-gates/quality-config/phpmd.xml">
        <exclude name="BooleanArgumentFlag"/>
        <exclude name="LongVariable"/>
    </rule>

    <!-- BooleanArgumentFlag: payroll domain services legitimately take boolean
         flags (`bool $isDryRun`, `bool $includeInactive`, `bool $recalculate`).
         The rule's premise — that a boolean argument signals a method doing two
         things — does not hold for a calculator whose caller chooses between
         "compute" and "compute and persist". Pervasive and idiomatic here. -->

    <!-- LongVariable: descriptive domain names are the norm in NL payroll and
         wage-tax code — $administrationId, $eindheffingDeclared,
         $vrijeRuimteDeclared. These are statutory concepts with long names; a
         shorter identifier would be a less accurate one. -->
</ruleset>
