{
  // STAYS `hrmq-docs`, and that is now a settled answer rather than a
  // deferral. Both `hrmq.conduction.nl` and `humaniq.conduction.nl` are
  // custom domains on THIS worker (attached 2026-08-23), so it serves the
  // new host as well as the old one. Renaming it would create a SECOND
  // worker while both custom domains keep routing to this one — every docs
  // deploy would go green while reaching nobody.
  //
  // `routes` is listed in full on purpose: wrangler reconciles triggers
  // against this file, so a host omitted here is REMOVED from the worker.
  "name": "hrmq-docs",
  "compatibility_date": "2025-06-01",
  "assets": { "directory": "./build", "not_found_handling": "404-page" },
  "workers_dev": true,
  "routes": [
    { "pattern": "hrmq.conduction.nl", "custom_domain": true },
    { "pattern": "humaniq.conduction.nl", "custom_domain": true }
  ]
}
