    <dependencies>
        <!-- ORDER IS LOAD-BEARING. info.xsd declares <dependencies> as a
             SEQUENCE: php, database, command, lib, owncloud, nextcloud,
             architecture, backend. With <nextcloud> first, xmllint rejects the
             file with "Element 'php': This element is not expected. Expected
             is one of ( architecture, backend )" — the elements are both
             valid, only their order was not. -->
        <php min-version="8.3"/>
        <nextcloud min-version="32" max-version="34"/>
        <!-- App dependency (not expressible in app-info.xsd): OpenRegister.
             HRMQ owns no database tables — Employee / EmploymentContract /
             PayrollRun / Payslip / WageTaxFiling / Timesheet / Expense objects
             all live in the OpenRegister `hrmq` register (imported via
             OCA\Hrmq\Repair\InitializeRegister), and the Vue manifest pages
             read/write that register directly through the
             @conduction/nextcloud-vue object store (src/manifest.json
             declares "dependencies": ["openregister"]). -->
    </dependencies>

    <!-- ORDER IS LOAD-BEARING, and this file had it wrong three ways. info.xsd
         declares the body of <info> as a SEQUENCE, so these blocks must appear
         as: dependencies, background-jobs, repair-steps, commands, navigations.
         <navigations> used to sit here (before <repair-steps>) and
         <background-jobs> sat after it, which is why xmllint rejected the file
         with "Element 'repair-steps': This element is not expected. Expected is
         one of ( contactsmenu, collaboration, openmetrics, sabre, trash,
         versions, external-app )" — once <navigations> is consumed, the schema
         will accept nothing that legally precedes it. Nothing here changed but
         the order. -->

    <background-jobs>
        <!-- Monthly statutory + bovenwettelijk leave accrual onto every active
             employee's holiday LeaveBalance (leave-accrual-job). Fires ~daily;
             the per-balance lastAccruedPeriod marker — not the interval —
             defines "once a month". Gated by the leave_accrual_enabled toggle. -->
        <job>OCA\Hrmq\BackgroundJob\LeaveAccrualJob</job>
    </background-jobs>

    <repair-steps>
        <!-- Order here is a SEQUENCE too: pre-migration, post-migration,
             live-migration, install, uninstall. <install> used to come first,
             which the schema rejects. Both steps are unchanged. -->
        <post-migration>
            <!-- Import the hrmq register (lib/Settings/hrmq_register.json +
                 register.d/*.json fragments) into OpenRegister. Idempotent;
                 fails soft when OpenRegister is not installed. -->
            <step>OCA\Hrmq\Repair\InitializeRegister</step>
            <!-- hrmq-asset-fleet-merge (tasks.md section 13, blocking defect):
                 rewrite pre-existing Asset/AssetAssignment objects from the
                 old Dutch dialect (category/status enum values, kenteken/
                 serienummer/aanschafdatum/aanschafwaarde, uitgifteDatum/
                 innameDatum/uitgifteBonSigned/eigenBijdrage) to the renamed
                 one — the schema rename above never touches an object that
                 already exists (OpenRegister's seed import is create-only).
                 Runs AFTER InitializeRegister so the new-dialect schema is
                 already imported. Idempotent; fails soft when OpenRegister is
                 not installed. post-migration (not live-migration) so it also
                 re-runs on `occ maintenance:repair`, not only on a real app
                 upgrade — see the step's own docblock. -->
            <step>OCA\Hrmq\Repair\MigrateAssetDialect</step>
            <!-- hours-process-redesign (Decision 9): backfill the Timesheet
                 identity caches (userId/managerUserId/administrationId),
                 synthesize one origin:"migration" TimeEntry per legacy
                 timesheet with hours but no entries, and recompute the
                 aggregates through the same TimesheetAggregationService the
                 runtime listener uses. Runs AFTER InitializeRegister so the
                 TimeEntry schema is already imported. Idempotent (re-runs
                 create nothing); one summary line per run; fails soft when
                 OpenRegister is not installed. -->
            <step>OCA\Hrmq\Repair\MigrateHoursProcess</step>
        </post-migration>
        <install>
            <!-- SAME step as post-migration, and that duplication is the point.
                 Nextcloud's Installer::installAppLastSteps() guards BOTH the
                 pre- and post-migration blocks with `if ($previousVersion !== '')`
                 — on a FRESH install `installed_version` is still empty, so
                 neither block runs. Only `repair-steps/install` is executed
                 unconditionally.

                 hrmq declared post-migration ONLY, so on every fresh install
                 the register import never ran at all: `occ app:enable hrmq`
                 printed "hrmq 0.2.0 enabled" and NOT ONE line of this step's
                 own output, the `hrmq` register was absent from OpenRegister,
                 and the SPA fell back to its default route on every page — the
                 shape the CI E2E suite hit as 68 failures whose two "passes"
                 were both the default route.

                 The step is idempotent and fails soft when OpenRegister is not
                 yet enabled, so running it on install AND on upgrade is safe;
                 whichever fires first wins and the other is a version-unchanged
                 skip. -->
            <step>OCA\Hrmq\Repair\InitializeRegister</step>
            <!-- hours-process-redesign: <install> is the ONLY hook that runs
                 unconditionally on a fresh install (see above) — without this
                 entry a fresh install would seed legacy-shaped timesheets and
                 never migrate them. Runs AFTER InitializeRegister; on fresh
                 installs it finds the seed rows and behaves identically. -->
            <step>OCA\Hrmq\Repair\MigrateHoursProcess</step>
        </install>
    </repair-steps>

    <commands>
        <!-- Audit the register's HR/labour objects against the machine-checkable
             rule corpus (lib/Standards/RuleCatalogue + RuleEngine). Read-only. -->
        <command>OCA\Hrmq\Command\RulesAuditCommand</command>
        <!-- Idempotently backfill local TEST data to satisfy the enforced rules
             (provider sample objects + provider field defaults). Test/dev. -->
        <command>OCA\Hrmq\Command\RulesSeedTestDataCommand</command>
        <!-- On-demand, hrmq-only re-run of the Asset/AssetAssignment dialect
             migration (hrmq-asset-fleet-merge, tasks.md section 13) also
             wired as the MigrateAssetDialect post-migration repair step.
             Idempotent; prints per-schema inspected/rewritten/alreadyCurrent/
             skipped counts and every skip reason. -->
        <command>OCA\Hrmq\Command\AssetsMigrateDialectCommand</command>
        <!-- Post each approved PayrollRun as a balanced loonjournaalpost into
             shillinq's JournalEntry register (payroll-glpost-shillinq MVP
             trigger). Duck-typed no-op when shillinq is absent. -->
        <command>OCA\Hrmq\Command\GlPostRunCommand</command>
        <!-- Hand off each payable PayrollRun's payslips as a draft SEPA
             PaymentRun into shillinq's PaymentRun register
             (payroll-sepa-netpay-shillinq MVP trigger). Duck-typed no-op when
             shillinq is absent. -->
        <command>OCA\Hrmq\Command\NetPayRunCommand</command>
        <!-- Generate standard HR documents (arbeidsovereenkomst, aanbiedingsbrief,
             werkgeversverklaring, getuigschrift) via docudesk's template/rendering
             engine (hrmq-docudesk-documents MVP trigger). Duck-typed no-op
             (skipped-no-docudesk) when docudesk is absent. -->
        <command>OCA\Hrmq\Command\DocumentsGenerateCommand</command>
        <!-- Extract receipt fields via docudesk's FinancialExtractionService
             and prefill still-empty Expense amount/expenseDate/vendor/
             vatAmount fields (receipt-ocr MVP trigger). Duck-typed no-op
             (skipped-no-docudesk) when docudesk is absent; never overwrites a
             human-entered value or changes Expense.status. -->
        <command>OCA\Hrmq\Command\ExpenseExtractReceiptCommand</command>
        <!-- Sync approved leave and sickness absence onto the configured
             shared Nextcloud calendar (leave-calendar-nc MVP trigger).
             Duck-typed no-op (skipped-no-calendar) when the calendar is not
             configured or cannot be resolved. -->
        <command>OCA\Hrmq\Command\CalendarSyncCommand</command>
        <!-- Create (or, with the recalculate option) the draft PayrollRun + engine Payslips
             for a wage period via the table-driven NL payroll calculator
             (payroll-core-engine MVP trigger). Draft-only; approval stays a
             human act. -->
        <command>OCA\Hrmq\Command\PayrollRunCommand</command>
        <!-- Run-scoped corpus audit over one period's PayrollRun(s) + their
             payslips (payroll-core-engine); exits non-zero on any mandatory
             violation. -->
        <command>OCA\Hrmq\Command\PayrollVerifyCommand</command>
        <!-- Recompute a sealed Payslip from its stored engineInputSnapshot
             (never the live Employee/EmploymentContract state) and compare
             cents-exact against the archived figures (audit-trail-payroll,
             fixing hrmq#98); exits non-zero on any mismatch or missing
             snapshot. -->
        <command>OCA\Hrmq\Command\PayrollReproduceCommand</command>
        <!-- Print (and optionally persist) the run-to-run payroll mutation
             report — who joined/left and each shared employee's per-component
             cents delta between two PayrollRuns (payroll-mutation-reports).
             Pure read over persisted payslips; never recomputes. -->
        <command>OCA\Hrmq\Command\PayrollMutationsCommand</command>
        <!-- Support-facing mirror of POST /api/payroll/proforma — simulate a
             gross-to-net breakdown from CLI flags (proforma-payslip MVP
             trigger). Persists nothing. -->
        <command>OCA\Hrmq\Command\ProformaPayslipCommand</command>
        <!-- Compute (and, with the apply option, settle) a terugwerkende
             kracht (TWK) correction for a sealed prior-period payslip as a
             delta — never mutates the sealed original (retro-adjustments
             MVP trigger). -->
        <command>OCA\Hrmq\Command\PayrollAdjustCommand</command>
        <!-- Annual tax-year roll preflight: asserts the new nl-YYYY.json
             table exists and reports the data-only, period-derived design
             (retro-adjustments). Changes no engine state. -->
        <command>OCA\Hrmq\Command\PayrollYearTransitionCommand</command>
        <!-- On-demand Arbeidstijdenwet cross-check over one Roster (by id or
             period) and its RosterAssignments, regardless of publish status
             (rostering MVP). Read-only; exits non-zero on any mandatory
             violation. -->
        <command>OCA\Hrmq\Command\RosterCheckCommand</command>
        <!-- Batch-effectuate every approved, due CompAdjustment in one
             compensation review cycle (comp-cycles MVP trigger): writes the
             new grossMonthlySalary onto the Employee and drives the
             effectuate transition. The dry-run option evaluates without writing. -->
        <command>OCA\Hrmq\Command\CompEffectuateCommand</command>
        <!-- Settle one approved LeaveTransaction (buy/sell leave hours,
             leave-buy-sell MVP trigger): idempotent, adjusts only
             LeaveBalance.bovenwettelijkHours and stamps the transaction
             settled, entitledHours/usedHours are never touched. -->
        <command>OCA\Hrmq\Command\LeaveBuySellSettleCommand</command>
        <!-- Compute/persist the idempotent per-(administration, year)
             werkkostenregeling vrije-ruimte assessment (wkr-administration
             MVP trigger): rolls the cross-object fiscale loonsom + WKR
             declarations into WkrAssessment. The all option iterates every
             distinct (administration, year) pair found across the payslips. -->
        <command>OCA\Hrmq\Command\WkrAssessCommand</command>
        <!-- AVG data-subject-rights orchestration over OpenRegister's DsarService
             (avg-dsr MVP trigger): export (Art 15 inzage / Art 20 portabiliteit),
             retention-guarded erase preview/execute (Art 17 vergetelheid), and
             rectify (Art 16). Each requires the as-user option to establish the
             privileged session DsarService::assertPrivileged() demands. -->
        <command>OCA\Hrmq\Command\AvgDsrExportCommand</command>
        <command>OCA\Hrmq\Command\AvgDsrEraseCommand</command>
        <command>OCA\Hrmq\Command\AvgDsrRectifyCommand</command>
        <!-- offer-esign: generate the offer-letter (aanbiedingsbrief) PDF and
             raise a docudesk e-signature request for one Application in
             status "aanbod". KNOWN LIMITATION: docudesk's
             SigningService::createRequest() throws "No authenticated user"
             from a genuine occ CLI process; the ApplicationDetail manifest
             action is the primary, actually-working write trigger. -->
        <command>OCA\Hrmq\Command\OfferRequestSignatureCommand</command>
        <!-- offer-esign: read-only poll of docudesk signing-request status
             onto Application.offerSigningStatus (getRequest() carries no
             session guard, so this genuinely works from CLI). Never writes
             Application.status or invokes the aannemen transition. -->
        <command>OCA\Hrmq\Command\OfferSyncSignatureCommand</command>
        <!-- interview-scheduling: sync scheduled recruiting Interviews onto
             the configured shared Nextcloud calendar (fork of
             CalendarSyncCommand for a second, separately-configured shared
             calendar). Duck-typed no-op (skipped-no-calendar) when the
             calendar is not configured or cannot be resolved. -->
        <command>OCA\Hrmq\Command\InterviewCalendarSyncCommand</command>
    </commands>

