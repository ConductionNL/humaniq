{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
	"version": "1.0.0",
	"dependencies": [
		"openregister"
	],
	"deepLinks": [
		{ "registerSlug": "hrmq", "schemaSlug": "Timesheet", "urlTemplate": "/apps/hrmq/timesheets/{uuid}", "displayName": "Timesheet" },
		{ "registerSlug": "hrmq", "schemaSlug": "Expense", "urlTemplate": "/apps/hrmq/expenses/{uuid}", "displayName": "Expense" },
		{ "registerSlug": "hrmq", "schemaSlug": "Employee", "urlTemplate": "/apps/hrmq/employees/{uuid}", "displayName": "Employee" },
		{ "registerSlug": "hrmq", "schemaSlug": "EmploymentContract", "urlTemplate": "/apps/hrmq/contracts/{uuid}", "displayName": "Employment Contract" },
		{ "registerSlug": "hrmq", "schemaSlug": "Payslip", "urlTemplate": "/apps/hrmq/payslips/{uuid}", "displayName": "Payslip" },
		{ "registerSlug": "hrmq", "schemaSlug": "PayrollRun", "urlTemplate": "/apps/hrmq/payroll-runs/{uuid}", "displayName": "Payroll Run" },
		{ "registerSlug": "hrmq", "schemaSlug": "LoonaangifteFiling", "urlTemplate": "/apps/hrmq/filings/{uuid}", "displayName": "Wage Tax Filing" }
	],
	"menu": [
		{
			"id": "EmployeesGroup",
			"label": "Personeel",
			"icon": "AccountOutline",
			"order": 90,
			"children": [
				{
					"id": "Employees",
					"label": "Werknemers",
					"icon": "AccountOutline",
					"route": "Employees"
				},
				{
					"id": "EmploymentContracts",
					"label": "Contracten",
					"icon": "FileSignOutline",
					"route": "EmploymentContracts"
				}
			]
		},
		{
			"id": "TimesheetsGroup",
			"label": "Uren",
			"icon": "ClockCheckOutline",
			"order": 100,
			"children": [
				{
					"id": "Timesheets",
					"label": "Urenregistratie",
					"icon": "ClockCheckOutline",
					"route": "Timesheets"
				},
				{
					"id": "TimesheetApproval",
					"label": "Urengoedkeuring",
					"icon": "CheckDecagramOutline",
					"route": "TimesheetApproval"
				}
			]
		},
		{
			"id": "ExpensesGroup",
			"label": "Onkosten",
			"icon": "Receipt",
			"order": 110,
			"children": [
				{
					"id": "Expenses",
					"label": "Declaraties",
					"icon": "Receipt",
					"route": "Expenses"
				},
				{
					"id": "ExpenseApproval",
					"label": "Declaratiegoedkeuring",
					"icon": "CheckDecagramOutline",
					"route": "ExpenseApproval"
				}
			]
		},
		{
			"id": "PayrollGroup",
			"label": "Loonadministratie",
			"icon": "CogPlayOutline",
			"order": 120,
			"children": [
				{
					"id": "Payslips",
					"label": "Loonstroken",
					"icon": "ReceiptTextOutline",
					"route": "Payslips"
				},
				{
					"id": "PayrollRuns",
					"label": "Loonruns",
					"icon": "CogPlayOutline",
					"route": "PayrollRuns"
				},
				{
					"id": "LoonaangifteFilings",
					"label": "Aangiftes",
					"icon": "FileSendOutline",
					"route": "LoonaangifteFilings"
				}
			]
		}
	],
	"pages": [
		{
			"id": "Timesheets",
			"route": "/timesheets",
			"type": "index",
			"title": "Urenregistratie",
			"config": {
				"register": "hrmq",
				"schema": "Timesheet",
				"columns": ["employeeId", "period", "hours", "billable", "status"],
				"filters": ["status", "period", "billable"],
				"sort": { "field": "period", "order": "desc" }
			}
		},
		{
			"id": "TimesheetApproval",
			"route": "/timesheets/approval",
			"type": "index",
			"title": "Urengoedkeuring",
			"config": {
				"register": "hrmq",
				"schema": "Timesheet",
				"description": "Ingediende urenstaten die wachten op goedkeuring of afkeuring.",
				"columns": ["employeeId", "period", "hours", "submittedAt", "status"],
				"filters": ["status", "period"],
				"defaultFilters": { "status": "submitted" },
				"sort": { "field": "submittedAt", "order": "asc" }
			}
		},
		{
			"id": "TimesheetDetail",
			"route": "/timesheets/:id",
			"type": "detail",
			"title": "Urenstaat",
			"config": {
				"register": "hrmq",
				"schema": "Timesheet",
				"_note": "HR/labour approval record (urenstaat). A single Timesheet captures the hours an employee logged for one period plus a submit -> approve/reject -> reopen approval workflow (x-openregister-lifecycle on `status`). Bespoke grid leads with the operational content: (1) a total-hours KPI stat so the approver sees the claimed volume at a glance; (2) the data widget (period / employee / hours / billable / project / cost centre / status / approval trail) as the primary 8-wide surface; (3) related alongside it for the linked Employee/project. Files sits full-width below for approval evidence and signed timesheets (approval documents matter, so they are on the body, not a tab). NO email/calendar/talk widgets -- the Timesheet schema declares no comms linkedTypes and a labour record does not correspond; any communication is with the person (Employee), not the record. lifecycleActions expose the schema's own submit/approve/reject/reopen transitions (guarded server-side by NoSelfApprovalGuard). Audit history is pushed to a sidebar tab as a rarely-scanned surface.",
				"widgets": [
					{ "id": "ts-hours", "type": "stat", "title": "Total hours", "content": { "label": "Total hours", "caption": "logged this period", "icon": "ClockCheckOutline", "valueColor": "#0082c9", "format": { "style": "number", "decimals": 2 }, "source": { "register": "hrmq", "schema": "Timesheet", "metric": "sum", "field": "hours", "filter": { "id": "@objectId" } } } },
					{ "id": "ts-data", "type": "data", "title": "Timesheet", "content": { "columns": 2 } },
					{ "id": "ts-related", "type": "related", "title": "Related" },
					{ "id": "ts-files", "type": "integration", "integrationId": "files", "title": "Approval documents" }
				],
				"layout": [
					{ "id": "1", "widgetId": "ts-hours", "gridX": 0, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "2", "widgetId": "ts-data", "gridX": 0, "gridY": 2, "gridWidth": 8, "gridHeight": 5 },
					{ "id": "3", "widgetId": "ts-related", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 7 },
					{ "id": "4", "widgetId": "ts-files", "gridX": 0, "gridY": 7, "gridWidth": 12, "gridHeight": 4 }
				],
				"lifecycleActions": {
					"field": "status",
					"transitions": ["submit", "approve", "reject", "reopen"]
				},
				"sidebar": { "enabled": true, "showMetadata": true, "tabs": [ { "id": "audit", "label": "History", "component": "CnAuditTrailTab", "config": { "linkedType": "audit-trail" } } ] }
			}
		},
		{
			"id": "Expenses",
			"route": "/expenses",
			"type": "index",
			"title": "Declaraties",
			"config": {
				"register": "hrmq",
				"schema": "Expense",
				"columns": ["employeeId", "title", "amount", "category", "expenseDate", "status"],
				"filters": ["status", "category"],
				"sort": { "field": "expenseDate", "order": "desc" }
			}
		},
		{
			"id": "ExpenseApproval",
			"route": "/expenses/approval",
			"type": "index",
			"title": "Declaratiegoedkeuring",
			"config": {
				"register": "hrmq",
				"schema": "Expense",
				"description": "Ingediende declaraties die wachten op goedkeuring of afkeuring.",
				"columns": ["employeeId", "title", "amount", "category", "submittedAt", "status"],
				"filters": ["status", "category"],
				"defaultFilters": { "status": "submitted" },
				"sort": { "field": "submittedAt", "order": "asc" }
			}
		},
		{
			"id": "ExpenseDetail",
			"route": "/expenses/:id",
			"type": "detail",
			"title": "Declaratie",
			"config": {
				"register": "hrmq",
				"schema": "Expense",
				"_note": "Expense-reimbursement claim (onkostendeclaratie). A single Expense holds one claim (amount / currency / category / date + attached receipt) and a submit -> approve/reject -> reimburse lifecycle (x-openregister-lifecycle on `status`). This grid is deliberately DIFFERENT from the Timesheet: the operational hero here is the RECEIPT, so the Files widget is a large full-width band right under the header -- the approver's first job is to open the bon and verify it against the claimed amount. An amount KPI stat sits top-right so the payout figure is unmissable. The data widget (title / amount / currency / category / expenseDate / receiptFile / status / approval + reimbursement trail) is the primary surface, with related for the linked Employee. NO email/calendar/talk -- Expense declares no comms linkedTypes; a reimbursement claim is a financial/HR record, not a correspondence thread. lifecycleActions expose submit/approve/reject/reimburse (approve/reject guarded server-side by NoSelfApprovalGuard; reimburse is terminal). Audit history is a sidebar tab.",
				"widgets": [
					{ "id": "ex-amount", "type": "stat", "title": "Claimed amount", "content": { "label": "Claimed amount", "caption": "to reimburse", "icon": "CashMultiple", "valueColor": "#46ba61", "format": { "style": "currency", "currency": "EUR", "decimals": 2 }, "source": { "register": "hrmq", "schema": "Expense", "metric": "sum", "field": "amount", "filter": { "id": "@objectId" } } } },
					{ "id": "ex-receipt", "type": "integration", "integrationId": "files", "title": "Receipt / bon" },
					{ "id": "ex-data", "type": "data", "title": "Expense claim", "content": { "columns": 2 } },
					{ "id": "ex-related", "type": "related", "title": "Related" }
				],
				"layout": [
					{ "id": "1", "widgetId": "ex-amount", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "2", "widgetId": "ex-receipt", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 4 },
					{ "id": "3", "widgetId": "ex-data", "gridX": 0, "gridY": 4, "gridWidth": 8, "gridHeight": 5 },
					{ "id": "4", "widgetId": "ex-related", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 7 }
				],
				"lifecycleActions": {
					"field": "status",
					"transitions": ["submit", "approve", "reject", "reimburse"]
				},
				"sidebar": { "enabled": true, "showMetadata": true, "tabs": [ { "id": "audit", "label": "History", "component": "CnAuditTrailTab", "config": { "linkedType": "audit-trail" } } ] }
			}
		},
		{
			"id": "Employees",
			"route": "/employees",
			"type": "index",
			"title": "Werknemers",
			"config": {
				"register": "hrmq",
				"schema": "Employee",
				"columns": ["employeeNumber", "firstName", "lastName", "startDate", "endDate", "taxTableColor"],
				"filters": ["taxTableColor"],
				"sort": { "field": "lastName", "order": "asc" }
			}
		},
		{
			"id": "EmployeeDetail",
			"route": "/employees/:id",
			"type": "detail",
			"title": "Werknemer",
			"config": {
				"register": "hrmq",
				"schema": "Employee",
				"_note": "Hub archetype: Employee is the record every other HR/payroll schema in hrmq points AT (EmploymentContract.employeeId, Payslip.employeeId, Timesheet.employeeId, Expense.employeeId), so the page's job is to be the single place an HR/payroll admin lands to see one person's whole labour and pay picture. The data widget (identity + payroll/compliance attributes: BSN, tax table colour, ID-document retention, 30%-ruling, A1 posting) leads at 8-wide; EmploymentContract sits beside it (4-wide) since the active contract's type/hourlyWage/awfTariff is the context every other number on this page depends on. Below, Payslip and Timesheet are paired FK-scoped lists (both period-based pay/hours records), then Expense and a Files leaf for the personnel file (justified by identityDocumentVerified/identityDocumentRetainedUntil/loonheffingenVerklaringOnFile -- real statutory document-retention fields on this schema, not a generic add). NO calendar/contacts/talk: Employee declares no appointment or comms linkedType -- the person's own identity data lives on this record, it is not a link to a separate NC contact. summaryAggregates give the at-a-glance headcount-of-one KPIs (contracts, payslips, pending expenses, hours logged). No lifecycleActions -- Employee carries no x-openregister-lifecycle. Audit history stays a sidebar tab.",
				"widgets": [
					{ "id": "emp-data", "type": "data", "title": "Employee", "content": { "columns": 2 } },
					{ "id": "emp-contracts", "type": "object-list", "title": "Contracts", "content": { "register": "hrmq", "schema": "EmploymentContract", "filter": { "employeeId": "@objectId" }, "sort": { "field": "startDate", "dir": "desc" }, "columns": [ { "key": "type", "label": "Type" }, { "key": "startDate", "label": "Start" }, { "key": "endDate", "label": "End" }, { "key": "hourlyWage", "label": "Hourly wage" }, { "key": "awfTariff", "label": "Awf tariff" } ], "limit": 10, "rowRoute": "EmploymentContractDetail" } },
					{ "id": "emp-payslips", "type": "object-list", "title": "Payslips", "content": { "register": "hrmq", "schema": "Payslip", "filter": { "employeeId": "@objectId" }, "sort": { "field": "period", "dir": "desc" }, "columns": [ { "key": "period", "label": "Period" }, { "key": "jurisdiction", "label": "Jurisdiction" }, { "key": "grossPay", "label": "Gross" }, { "key": "nettoPay", "label": "Net" } ], "limit": 10, "rowRoute": "PayslipDetail" } },
					{ "id": "emp-timesheets", "type": "object-list", "title": "Timesheets", "content": { "register": "hrmq", "schema": "Timesheet", "filter": { "employeeId": "@objectId" }, "sort": { "field": "period", "dir": "desc" }, "columns": [ { "key": "period", "label": "Period" }, { "key": "hours", "label": "Hours" }, { "key": "status", "label": "Status" } ], "limit": 10, "rowRoute": "TimesheetDetail" } },
					{ "id": "emp-expenses", "type": "object-list", "title": "Expenses", "content": { "register": "hrmq", "schema": "Expense", "filter": { "employeeId": "@objectId" }, "sort": { "field": "expenseDate", "dir": "desc" }, "columns": [ { "key": "title", "label": "Title" }, { "key": "amount", "label": "Amount" }, { "key": "status", "label": "Status" } ], "limit": 10, "rowRoute": "ExpenseDetail" } },
					{ "id": "emp-files", "type": "integration", "integrationId": "files", "title": "Personnel file" }
				],
				"layout": [
					{ "id": "1", "widgetId": "emp-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 6 },
					{ "id": "2", "widgetId": "emp-contracts", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 6 },
					{ "id": "3", "widgetId": "emp-payslips", "gridX": 0, "gridY": 6, "gridWidth": 6, "gridHeight": 5 },
					{ "id": "4", "widgetId": "emp-timesheets", "gridX": 6, "gridY": 6, "gridWidth": 6, "gridHeight": 5 },
					{ "id": "5", "widgetId": "emp-expenses", "gridX": 0, "gridY": 11, "gridWidth": 6, "gridHeight": 5 },
					{ "id": "6", "widgetId": "emp-files", "gridX": 6, "gridY": 11, "gridWidth": 6, "gridHeight": 5 }
				],
				"summaryAggregates": [
					{ "label": "Contracts", "register": "hrmq", "schema": "EmploymentContract", "metric": "count", "filter": { "employeeId": "@objectId" } },
					{ "label": "Payslips", "register": "hrmq", "schema": "Payslip", "metric": "count", "filter": { "employeeId": "@objectId" } },
					{ "label": "Pending expenses", "register": "hrmq", "schema": "Expense", "metric": "count", "filter": { "employeeId": "@objectId", "status": "submitted" } },
					{ "label": "Hours logged", "register": "hrmq", "schema": "Timesheet", "metric": "sum", "field": "hours", "filter": { "employeeId": "@objectId" } }
				],
				"sidebar": { "enabled": true, "showMetadata": true, "tabs": [ { "id": "audit", "label": "History", "component": "CnAuditTrailTab" } ] }
			}
		},
		{
			"id": "EmploymentContracts",
			"route": "/contracts",
			"type": "index",
			"title": "Contracten",
			"config": {
				"register": "hrmq",
				"schema": "EmploymentContract",
				"columns": ["employeeId", "type", "startDate", "endDate", "hourlyWage", "awfTariff"],
				"filters": ["type", "awfTariff"],
				"sort": { "field": "startDate", "order": "desc" }
			}
		},
		{
			"id": "EmploymentContractDetail",
			"route": "/contracts/:id",
			"type": "detail",
			"title": "Contract",
			"config": {
				"register": "hrmq",
				"schema": "EmploymentContract",
				"_note": "Leaf compliance record: no other schema in hrmq references EmploymentContract by FK, so the page is a simple two-panel layout -- the data widget (type/writtenContract/dates/hoursPerWeek/hourlyWage/cao/awfTariff plus the jurisdiction-specific fields: workingTimeDocumented, overtimeMultiplier, ftePartOfYearMinijob, dpaeFiledBeforeStart) at 8-wide, and Related at 4-wide for the one meaningful outbound ref this schema carries -- employeeId, the Employee the contract belongs to. No child lists (nothing points at a contract), no files/calendar/comms leaves (no linkedType or document field evidence on this schema), no lifecycleActions (EmploymentContract has no x-openregister-lifecycle). Audit history is a sidebar tab.",
				"widgets": [
					{ "id": "ct-data", "type": "data", "title": "Contract", "content": { "columns": 2 } },
					{ "id": "ct-related", "type": "related", "title": "Related" }
				],
				"layout": [
					{ "id": "1", "widgetId": "ct-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 5 },
					{ "id": "2", "widgetId": "ct-related", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 5 }
				],
				"sidebar": { "enabled": true, "showMetadata": true, "tabs": [ { "id": "audit", "label": "History", "component": "CnAuditTrailTab" } ] }
			}
		},
		{
			"id": "Payslips",
			"route": "/payslips",
			"type": "index",
			"title": "Loonstroken",
			"config": {
				"register": "hrmq",
				"schema": "Payslip",
				"columns": ["employeeId", "period", "jurisdiction", "grossPay", "nettoPay"],
				"filters": ["jurisdiction", "period"],
				"sort": { "field": "period", "order": "desc" }
			}
		},
		{
			"id": "PayslipDetail",
			"route": "/payslips/:id",
			"type": "detail",
			"title": "Loonstrook",
			"config": {
				"register": "hrmq",
				"schema": "Payslip",
				"_note": "Financial-document archetype (x-schema-org: schema:Invoice), same family as Expense's amount-first design: two headline stat KPIs (gross/net pay) lead the page since that is what an employee or approver checks first, followed by the dense data widget carrying the full gross-to-net withholding breakdown (NL loonheffing/zvw/wkr, DE Lohnsteuer/Soli/Kirchensteuer, FR cotisations/PAS, US FICA/Medicare -- the schema is genuinely multi-jurisdiction so all fields surface via the data widget rather than being cherry-picked). Related sits alongside for the one outbound ref -- employeeId, the Employee this payslip was issued to. Stat format uses 'number' not 'currency' because Payslip.currency varies per record (EUR/USD) and a widget's format is static. No files/calendar/comms leaves: nothing in the schema models an attachable payslip document or appointment, and Payslip carries no x-openregister-lifecycle so there are no lifecycleActions. Audit history is a sidebar tab.",
				"widgets": [
					{ "id": "ps-gross", "type": "stat", "title": "Gross pay", "content": { "label": "Gross pay", "caption": "this period", "icon": "CashPlus", "valueColor": "#0082c9", "format": { "style": "number", "decimals": 2 }, "source": { "register": "hrmq", "schema": "Payslip", "metric": "sum", "field": "grossPay", "filter": { "id": "@objectId" } } } },
					{ "id": "ps-net", "type": "stat", "title": "Net pay", "content": { "label": "Net pay", "caption": "paid out", "icon": "CashCheck", "valueColor": "#46ba61", "format": { "style": "number", "decimals": 2 }, "source": { "register": "hrmq", "schema": "Payslip", "metric": "sum", "field": "nettoPay", "filter": { "id": "@objectId" } } } },
					{ "id": "ps-data", "type": "data", "title": "Payslip breakdown", "content": { "columns": 2 } },
					{ "id": "ps-related", "type": "related", "title": "Related" }
				],
				"layout": [
					{ "id": "1", "widgetId": "ps-gross", "gridX": 0, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "2", "widgetId": "ps-net", "gridX": 4, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "3", "widgetId": "ps-data", "gridX": 0, "gridY": 2, "gridWidth": 8, "gridHeight": 7 },
					{ "id": "4", "widgetId": "ps-related", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 9 }
				],
				"sidebar": { "enabled": true, "showMetadata": true, "tabs": [ { "id": "audit", "label": "History", "component": "CnAuditTrailTab" } ] }
			}
		},
		{
			"id": "PayrollRuns",
			"route": "/payroll-runs",
			"type": "index",
			"title": "Loonruns",
			"config": {
				"register": "hrmq",
				"schema": "PayrollRun",
				"columns": ["period", "administrationId", "jurisdiction", "status", "totalGross", "totalNet"],
				"filters": ["status", "jurisdiction"],
				"sort": { "field": "period", "order": "desc" }
			}
		},
		{
			"id": "PayrollRunDetail",
			"route": "/payroll-runs/:id",
			"type": "detail",
			"title": "Loonrun",
			"config": {
				"register": "hrmq",
				"schema": "PayrollRun",
				"_note": "Batch/reconciliation archetype: a PayrollRun is a per-period aggregate of an administration's payslips, so its page leads with the GL-reconciliation totals (totalGross/totalNet/withholdingLiabilityBalance -- exactly the numbers xc-payroll-gl-reconciliation and xc-withholding-liability-clearing check) as stat KPIs, then the full record (period/administrationId/jurisdiction/status/glLiabilityPosted/glExpensePosted/withholdingsClearedToZero) in the data widget below. NO Payslip child list and NO related panel: Payslip carries no payrollRunId (or any) FK back to PayrollRun in the schema, and administrationId is a bare string, not a resolvable object reference -- adding either would fabricate a relation the schema does not carry. NO lifecycleActions: `status` is a plain enum (draft/approved/posted/paid) with no `x-openregister-lifecycle` transition map on this schema, unlike Timesheet/Expense -- driving lifecycleActions here would invent transition names the backend does not guard. Audit history is a sidebar tab.",
				"widgets": [
					{ "id": "pr-gross", "type": "stat", "title": "Total gross", "content": { "label": "Total gross", "caption": "this period", "icon": "CashMultiple", "valueColor": "#0082c9", "format": { "style": "number", "decimals": 2 }, "source": { "register": "hrmq", "schema": "PayrollRun", "metric": "sum", "field": "totalGross", "filter": { "id": "@objectId" } } } },
