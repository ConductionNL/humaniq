{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
	"version": "1.0.0",
	"dependencies": [
		"openregister"
	],
	"deepLinks": [
		{ "registerSlug": "hrmq", "schemaSlug": "Timesheet", "urlTemplate": "/apps/hrmq/timesheets/{uuid}", "displayName": "Timesheet" },
		{ "registerSlug": "hrmq", "schemaSlug": "Expense", "urlTemplate": "/apps/hrmq/expenses/{uuid}", "displayName": "Expense" },
		{ "registerSlug": "hrmq", "schemaSlug": "Employee", "urlTemplate": "/apps/hrmq/employees/{uuid}", "displayName": "Employee" },
		{ "registerSlug": "hrmq", "schemaSlug": "EmploymentContract", "urlTemplate": "/apps/hrmq/contracts/{uuid}", "displayName": "Employment Contract" },
		{ "registerSlug": "hrmq", "schemaSlug": "Payslip", "urlTemplate": "/apps/hrmq/payslips/{uuid}", "displayName": "Payslip" },
		{ "registerSlug": "hrmq", "schemaSlug": "PayrollRun", "urlTemplate": "/apps/hrmq/payroll-runs/{uuid}", "displayName": "Payroll Run" },
		{ "registerSlug": "hrmq", "schemaSlug": "LoonaangifteFiling", "urlTemplate": "/apps/hrmq/filings/{uuid}", "displayName": "Wage Tax Filing" }
	],
	"menu": [
		{
			"id": "EmployeesGroup",
			"label": "Personeel",
			"icon": "AccountOutline",
			"order": 90,
			"children": [
				{
					"id": "Employees",
					"label": "Werknemers",
					"icon": "AccountOutline",
					"route": "Employees"
				},
				{
					"id": "EmploymentContracts",
					"label": "Contracten",
					"icon": "FileSignOutline",
					"route": "EmploymentContracts"
				}
			]
		},
		{
			"id": "TimesheetsGroup",
			"label": "Uren",
			"icon": "ClockCheckOutline",
			"order": 100,
			"children": [
				{
					"id": "Timesheets",
					"label": "Urenregistratie",
					"icon": "ClockCheckOutline",
					"route": "Timesheets"
				},
				{
					"id": "TimesheetApproval",
					"label": "Urengoedkeuring",
					"icon": "CheckDecagramOutline",
					"route": "TimesheetApproval"
				}
			]
		},
		{
			"id": "ExpensesGroup",
			"label": "Onkosten",
			"icon": "Receipt",
			"order": 110,
			"children": [
				{
					"id": "Expenses",
					"label": "Declaraties",
					"icon": "Receipt",
					"route": "Expenses"
				},
				{
					"id": "ExpenseApproval",
					"label": "Declaratiegoedkeuring",
					"icon": "CheckDecagramOutline",
					"route": "ExpenseApproval"
				}
			]
		},
		{
			"id": "PayrollGroup",
			"label": "Loonadministratie",
			"icon": "CogPlayOutline",
			"order": 120,
			"children": [
				{
					"id": "Payslips",
					"label": "Loonstroken",
					"icon": "ReceiptTextOutline",
					"route": "Payslips"
				},
				{
					"id": "PayrollRuns",
					"label": "Loonruns",
					"icon": "CogPlayOutline",
					"route": "PayrollRuns"
				},
				{
					"id": "LoonaangifteFilings",
					"label": "Aangiftes",
					"icon": "FileSendOutline",
					"route": "LoonaangifteFilings"
				}
			]
		}
	],
	"pages": [
		{
			"id": "Timesheets",
			"route": "/timesheets",
			"type": "index",
			"title": "Urenregistratie",
			"config": {
				"register": "hrmq",
				"schema": "Timesheet",
				"columns": ["employeeId", "period", "hours", "billable", "status"],
				"filters": ["status", "period", "billable"],
				"sort": { "field": "period", "order": "desc" }
			}
		},
		{
			"id": "TimesheetApproval",
			"route": "/timesheets/approval",
			"type": "index",
			"title": "Urengoedkeuring",
			"config": {
				"register": "hrmq",
				"schema": "Timesheet",
				"description": "Ingediende urenstaten die wachten op goedkeuring of afkeuring.",
				"columns": ["employeeId", "period", "hours", "submittedAt", "status"],
				"filters": ["status", "period"],
				"defaultFilters": { "status": "submitted" },
				"sort": { "field": "submittedAt", "order": "asc" }
			}
		},
		{
			"id": "TimesheetDetail",
			"route": "/timesheets/:id",
			"type": "detail",
			"title": "Urenstaat",
			"config": {
				"register": "hrmq",
				"schema": "Timesheet",
				"_note": "HR/labour approval record (urenstaat). A single Timesheet captures the hours an employee logged for one period plus a submit -> approve/reject -> reopen approval workflow (x-openregister-lifecycle on `status`). ADR-062 round-2 rework: (1) total-hours KPI stat top-left so the approver sees the claimed volume at a glance; (2) the data widget SPLIT into 'Time entry' (period/description/project/cost centre/billable -- what was worked) and 'Approval' (status/submittedAt/approvedBy/approvedAt/rejectionReason -- the workflow trail), each excluding employeeId since the Related panel already resolves and links the claiming Employee by name; (3) related alongside both, matching their combined height. Files sits full-width below for approval evidence and signed timesheets (approval documents matter, so they are on the body, not a tab). NO email/calendar/talk widgets -- the Timesheet schema declares no comms linkedTypes and a labour record does not correspond; any communication is with the person (Employee), not the record. lifecycleActions expose the schema's own submit/approve/reject/reopen transitions (guarded server-side by NoSelfApprovalGuard). Audit history is pushed to a sidebar tab as a rarely-scanned surface.",
				"widgets": [
					{ "id": "ts-hours", "type": "stat", "title": "Total hours", "icon": "Timeline", "content": { "label": "Total hours", "caption": "logged this period", "icon": "Timeline", "valueColor": "#0082c9", "format": { "style": "number", "decimals": 2 }, "source": { "register": "hrmq", "schema": "Timesheet", "metric": "sum", "field": "hours", "filter": { "id": "@objectId" } } } },
					{ "id": "ts-data", "type": "data", "title": "Time entry", "icon": "ClipboardList", "content": { "columns": 2, "exclude": ["employeeId"] } },
					{ "id": "ts-approval", "type": "data", "title": "Approval", "icon": "CheckCircleOutline", "content": { "columns": 2, "include": ["status", "submittedAt", "approvedBy", "approvedAt", "rejectionReason"] } },
					{ "id": "ts-related", "type": "related", "title": "Related", "icon": "LinkVariant" },
					{ "id": "ts-files", "type": "integration", "integrationId": "files", "title": "Approval documents", "icon": "FolderOutline" }
				],
				"layout": [
					{ "id": "1", "widgetId": "ts-hours", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 2 },
					{ "id": "2", "widgetId": "ts-data", "gridX": 0, "gridY": 2, "gridWidth": 8, "gridHeight": 4 },
					{ "id": "3", "widgetId": "ts-approval", "gridX": 0, "gridY": 6, "gridWidth": 8, "gridHeight": 4 },
					{ "id": "4", "widgetId": "ts-related", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 10 },
					{ "id": "5", "widgetId": "ts-files", "gridX": 0, "gridY": 10, "gridWidth": 12, "gridHeight": 4 }
				],
				"lifecycleActions": {
					"field": "status",
					"transitions": [
						{ "action": "submit", "from": ["draft", "rejected"], "to": "submitted", "label": "Submit" },
						{ "action": "approve", "from": ["submitted"], "to": "approved", "label": "Approve" },
						{ "action": "reject", "from": ["submitted"], "to": "rejected", "label": "Reject" },
						{ "action": "reopen", "from": ["approved"], "to": "draft", "label": "Reopen" }
					]
				},
				"sidebar": { "enabled": true, "showMetadata": true, "tabs": [ { "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ], "config": { "linkedType": "audit-trail" } } ] }
			}
		},
		{
			"id": "Expenses",
			"route": "/expenses",
			"type": "index",
			"title": "Declaraties",
			"config": {
				"register": "hrmq",
				"schema": "Expense",
				"columns": ["employeeId", "title", "amount", "category", "expenseDate", "status"],
				"filters": ["status", "category"],
				"sort": { "field": "expenseDate", "order": "desc" }
			}
		},
		{
			"id": "ExpenseApproval",
			"route": "/expenses/approval",
			"type": "index",
			"title": "Declaratiegoedkeuring",
			"config": {
				"register": "hrmq",
				"schema": "Expense",
				"description": "Ingediende declaraties die wachten op goedkeuring of afkeuring.",
				"columns": ["employeeId", "title", "amount", "category", "submittedAt", "status"],
				"filters": ["status", "category"],
				"defaultFilters": { "status": "submitted" },
				"sort": { "field": "submittedAt", "order": "asc" }
			}
		},
		{
			"id": "ExpenseDetail",
			"route": "/expenses/:id",
			"type": "detail",
			"title": "Declaratie",
			"config": {
				"register": "hrmq",
				"schema": "Expense",
				"_note": "Expense-reimbursement claim (onkostendeclaratie). A single Expense holds one claim (amount / currency / category / date + attached receipt) and a submit -> approve/reject -> reimburse lifecycle (x-openregister-lifecycle on `status`). Content starts at gridY 0 with the 'Claim' data (title/description/amount/currency/category/expenseDate/receiptFile) then 'Approval' (status/submittedAt/approvedBy/approvedAt/rejectionReason/reimbursedAt) below it, both excluding employeeId since Related already resolves the claiming Employee by name; an amount KPI stat sits top-right so the payout figure is unmissable, with Related beneath it matching the combined left-column height. The Files widget (receipt / bon) runs full-width AFTER the domain cards, same placement convention as Timesheet's approval evidence -- the approver reads the claim record first, then opens the receipt to verify it. NO email/calendar/talk -- Expense declares no comms linkedTypes; a reimbursement claim is a financial/HR record, not a correspondence thread. lifecycleActions expose submit/approve/reject/reimburse (approve/reject guarded server-side by NoSelfApprovalGuard; reimburse is terminal). Audit history is a sidebar tab.",
				"widgets": [
					{ "id": "ex-amount", "type": "stat", "title": "Claimed amount", "icon": "CashMultiple", "content": { "label": "Claimed amount", "caption": "to reimburse", "icon": "CashMultiple", "valueColor": "#46ba61", "format": { "style": "currency", "currency": "EUR", "decimals": 2 }, "source": { "register": "hrmq", "schema": "Expense", "metric": "sum", "field": "amount", "filter": { "id": "@objectId" } } } },
					{ "id": "ex-receipt", "type": "integration", "integrationId": "files", "title": "Receipt / bon", "icon": "FolderOutline" },
					{ "id": "ex-data", "type": "data", "title": "Claim", "icon": "ClipboardList", "content": { "columns": 2, "include": ["title", "description", "amount", "currency", "category", "expenseDate", "receiptFile"] } },
					{ "id": "ex-approval", "type": "data", "title": "Approval", "icon": "CheckCircleOutline", "content": { "columns": 2, "include": ["status", "submittedAt", "approvedBy", "approvedAt", "rejectionReason", "reimbursedAt"] } },
					{ "id": "ex-related", "type": "related", "title": "Related", "icon": "LinkVariant" }
				],
				"layout": [
					{ "id": "1", "widgetId": "ex-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 5 },
					{ "id": "2", "widgetId": "ex-approval", "gridX": 0, "gridY": 5, "gridWidth": 8, "gridHeight": 4 },
					{ "id": "3", "widgetId": "ex-receipt", "gridX": 0, "gridY": 9, "gridWidth": 12, "gridHeight": 4 },
					{ "id": "4", "widgetId": "ex-amount", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "5", "widgetId": "ex-related", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 7 }
				],
				"lifecycleActions": {
					"field": "status",
					"transitions": [
						{ "action": "submit", "from": ["draft", "rejected"], "to": "submitted", "label": "Submit" },
						{ "action": "approve", "from": ["submitted"], "to": "approved", "label": "Approve" },
						{ "action": "reject", "from": ["submitted"], "to": "rejected", "label": "Reject" },
						{ "action": "reimburse", "from": ["approved"], "to": "reimbursed", "label": "Reimburse" }
					]
				},
				"sidebar": { "enabled": true, "showMetadata": true, "tabs": [ { "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ], "config": { "linkedType": "audit-trail" } } ] }
			}
		},
		{
			"id": "Employees",
			"route": "/employees",
			"type": "index",
			"title": "Werknemers",
			"config": {
				"register": "hrmq",
				"schema": "Employee",
				"columns": ["employeeNumber", "firstName", "lastName", "startDate", "endDate", "taxTableColor"],
				"filters": ["taxTableColor"],
				"sort": { "field": "lastName", "order": "asc" }
			}
		},
		{
			"id": "EmployeeDetail",
			"route": "/employees/:id",
			"type": "detail",
			"title": "Werknemer",
			"config": {
				"register": "hrmq",
				"schema": "Employee",
				"_note": "Hub archetype: Employee is the record every other HR/payroll schema in hrmq points AT (EmploymentContract.employeeId, Payslip.employeeId, Timesheet.employeeId, Expense.employeeId — all now canonical $ref relations, ADR-062 rule 7), so the page's job is to be the single place an HR/payroll admin lands to see one person's whole labour and pay picture. ADR-062 round-2 rework: the data widget is SPLIT into 'Person' (employeeNumber/firstName/lastName/dateOfBirth/bsn — the identity attributes) at 8-wide beside an in-grid stats-block (KPIs, top-right — replaces the deprecated summaryAggregates header chips) at 4-wide; 'Employment & compliance' (startDate/endDate/grossMonthlySalary/taxTableColor/ID-document retention/30%-ruling/A1 posting/jurisdiction-specific onboarding flags — 18 fields, genuinely this schema's bulk) runs full-width below since it has no natural width-4 partner. Contracts and Timesheets are paired FK-scoped lists, then Payslips (allowCreate:false — payroll-generated, not hand-created from here) and Expenses, then a Files leaf for the personnel file (justified by identityDocumentVerified/identityDocumentRetainedUntil/loonheffingenVerklaringOnFile — real statutory document-retention fields on this schema, not a generic add). NO calendar/contacts/talk: Employee declares no appointment or comms linkedType — the person's own identity data lives on this record, it is not a link to a separate NC contact. No lifecycleActions — Employee carries no x-openregister-lifecycle. Audit history stays a sidebar tab.",
				"widgets": [
					{ "id": "emp-person", "type": "data", "title": "Person", "icon": "Account", "content": { "columns": 2, "include": ["employeeNumber", "firstName", "lastName", "dateOfBirth", "bsn"] } },
					{ "id": "emp-stats-contracts", "type": "stats-block", "title": "Contracts", "icon": "ChartBar", "content": { "entries": [
						{ "title": "Contracts", "register": "hrmq", "schema": "EmploymentContract", "metric": "count", "filter": { "employeeId": "@objectId" }, "route": "EmploymentContracts" }
					] } },
					{ "id": "emp-stats-payslips", "type": "stats-block", "title": "Payslips", "icon": "ChartBar", "content": { "entries": [
						{ "title": "Payslips", "register": "hrmq", "schema": "Payslip", "metric": "count", "filter": { "employeeId": "@objectId" }, "route": "Payslips" }
					] } },
					{ "id": "emp-stats-pending-expenses", "type": "stats-block", "title": "Pending expenses", "icon": "ChartBar", "content": { "entries": [
						{ "title": "Pending expenses", "register": "hrmq", "schema": "Expense", "metric": "count", "filter": { "employeeId": "@objectId", "status": "submitted" }, "route": "ExpenseApproval" }
					] } },
					{ "id": "emp-stats-hours-logged", "type": "stats-block", "title": "Hours logged", "icon": "ChartBar", "content": { "entries": [
						{ "title": "Hours logged", "register": "hrmq", "schema": "Timesheet", "metric": "sum", "field": "hours", "filter": { "employeeId": "@objectId" }, "route": "Timesheets" }
					] } },
					{ "id": "emp-compliance", "type": "data", "title": "Employment & compliance", "icon": "ShieldCheckOutline", "content": { "columns": 3, "exclude": ["employeeNumber", "firstName", "lastName", "dateOfBirth", "bsn"] } },
					{ "id": "emp-contracts", "type": "object-list", "title": "Contracts", "icon": "FileSign", "content": { "register": "hrmq", "schema": "EmploymentContract", "filter": { "employeeId": "@objectId" }, "sort": { "field": "startDate", "dir": "desc" }, "columns": [ { "key": "type", "label": "Type" }, { "key": "startDate", "label": "Start" }, { "key": "endDate", "label": "End" }, { "key": "hourlyWage", "label": "Hourly wage" }, { "key": "awfTariff", "label": "Awf tariff" } ], "limit": 25, "rowRoute": "EmploymentContractDetail", "viewAllRoute": "EmploymentContracts", "viewAllQuery": { "employeeId": "@objectId" }, "emptyText": "No contracts yet" } },
					{ "id": "emp-timesheets", "type": "object-list", "title": "Timesheets", "icon": "Timeline", "content": { "register": "hrmq", "schema": "Timesheet", "filter": { "employeeId": "@objectId" }, "sort": { "field": "period", "dir": "desc" }, "columns": [ { "key": "period", "label": "Period" }, { "key": "hours", "label": "Hours" }, { "key": "status", "label": "Status" } ], "limit": 25, "rowRoute": "TimesheetDetail", "viewAllRoute": "Timesheets", "viewAllQuery": { "employeeId": "@objectId" }, "emptyText": "No timesheets logged yet" } },
					{ "id": "emp-payslips", "type": "object-list", "title": "Payslips", "icon": "Cash", "content": { "register": "hrmq", "schema": "Payslip", "filter": { "employeeId": "@objectId" }, "sort": { "field": "period", "dir": "desc" }, "columns": [ { "key": "period", "label": "Period" }, { "key": "jurisdiction", "label": "Jurisdiction" }, { "key": "grossPay", "label": "Gross" }, { "key": "nettoPay", "label": "Net" } ], "limit": 25, "rowRoute": "PayslipDetail", "viewAllRoute": "Payslips", "viewAllQuery": { "employeeId": "@objectId" }, "emptyText": "No payslips yet", "allowCreate": false } },
					{ "id": "emp-expenses", "type": "object-list", "title": "Expenses", "icon": "CashMultiple", "content": { "register": "hrmq", "schema": "Expense", "filter": { "employeeId": "@objectId" }, "sort": { "field": "expenseDate", "dir": "desc" }, "columns": [ { "key": "title", "label": "Title" }, { "key": "amount", "label": "Amount" }, { "key": "status", "label": "Status" } ], "limit": 25, "rowRoute": "ExpenseDetail", "viewAllRoute": "Expenses", "viewAllQuery": { "employeeId": "@objectId" }, "emptyText": "No expense claims yet" } },
					{ "id": "emp-files", "type": "integration", "integrationId": "files", "title": "Personnel file", "icon": "FolderOutline" }
				],
				"layout": [
					{ "id": "1", "widgetId": "emp-person", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 6 },
					{ "id": "2-1", "widgetId": "emp-stats-contracts", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "2-2", "widgetId": "emp-stats-payslips", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "2-3", "widgetId": "emp-stats-pending-expenses", "gridX": 8, "gridY": 4, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "2-4", "widgetId": "emp-stats-hours-logged", "gridX": 8, "gridY": 6, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "3", "widgetId": "emp-compliance", "gridX": 0, "gridY": 8, "gridWidth": 12, "gridHeight": 7 },
					{ "id": "4", "widgetId": "emp-contracts", "gridX": 0, "gridY": 15, "gridWidth": 6, "gridHeight": 4 },
					{ "id": "5", "widgetId": "emp-timesheets", "gridX": 6, "gridY": 15, "gridWidth": 6, "gridHeight": 4 },
					{ "id": "6", "widgetId": "emp-payslips", "gridX": 0, "gridY": 19, "gridWidth": 6, "gridHeight": 4 },
					{ "id": "7", "widgetId": "emp-expenses", "gridX": 6, "gridY": 19, "gridWidth": 6, "gridHeight": 4 },
					{ "id": "8", "widgetId": "emp-files", "gridX": 0, "gridY": 23, "gridWidth": 12, "gridHeight": 4 }
				],
				"sidebar": { "enabled": true, "showMetadata": true, "tabs": [ { "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] } ] }
			}
		},
		{
			"id": "EmploymentContracts",
			"route": "/contracts",
			"type": "index",
			"title": "Contracten",
			"config": {
				"register": "hrmq",
				"schema": "EmploymentContract",
				"columns": ["employeeId", "type", "startDate", "endDate", "hourlyWage", "awfTariff"],
				"filters": ["type", "awfTariff"],
				"sort": { "field": "startDate", "order": "desc" }
			}
		},
		{
			"id": "EmploymentContractDetail",
			"route": "/contracts/:id",
			"type": "detail",
			"title": "Contract",
			"config": {
				"register": "hrmq",
				"schema": "EmploymentContract",
				"_note": "Leaf compliance record: no other schema in hrmq references EmploymentContract by FK, so the page is a simple two-panel layout -- the data widget (type/writtenContract/dates/hoursPerWeek/hourlyWage/cao/awfTariff plus the jurisdiction-specific fields: workingTimeDocumented, overtimeMultiplier, ftePartOfYearMinijob, dpaeFiledBeforeStart) at 8-wide, excluding employeeId since the Related panel already resolves and links the owning Employee by name -- and Related at 4-wide for that one meaningful outbound ref. No child lists (nothing points at a contract), no files/calendar/comms leaves (no linkedType or document field evidence on this schema), no lifecycleActions (EmploymentContract has no x-openregister-lifecycle). Audit history is a sidebar tab.",
				"widgets": [
					{ "id": "ct-data", "type": "data", "title": "Contract", "icon": "FileSign", "content": { "columns": 2, "exclude": ["employeeId"] } },
					{ "id": "ct-related", "type": "related", "title": "Related", "icon": "LinkVariant" }
				],
				"layout": [
					{ "id": "1", "widgetId": "ct-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 7 },
					{ "id": "2", "widgetId": "ct-related", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 7 }
				],
				"sidebar": { "enabled": true, "showMetadata": true, "tabs": [ { "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] } ] }
			}
		},
		{
			"id": "Payslips",
			"route": "/payslips",
			"type": "index",
			"title": "Loonstroken",
			"config": {
				"register": "hrmq",
				"schema": "Payslip",
				"columns": ["employeeId", "period", "jurisdiction", "grossPay", "nettoPay"],
				"filters": ["jurisdiction", "period"],
				"sort": { "field": "period", "order": "desc" }
			}
		},
		{
			"id": "PayslipDetail",
			"route": "/payslips/:id",
			"type": "detail",
			"title": "Loonstrook",
			"config": {
				"register": "hrmq",
				"schema": "Payslip",
				"_note": "Financial-document archetype (x-schema-org: schema:Invoice), same family as Expense's amount-first design: three headline tiles (gross pay, net pay, Related-to-Employee) lead the page since that is what an employee or approver checks first, followed by the dense data widget carrying the full gross-to-net withholding breakdown (NL loonheffing/zvw/wkr, DE Lohnsteuer/Soli/Kirchensteuer, FR cotisations/PAS, US FICA/Medicare -- the schema is genuinely multi-jurisdiction: only one jurisdiction's fields populate per real record, but which one varies per payslip so a static manifest cannot cherry-pick per-instance; all fields surface via one widget, sized to its true field count and set to 4 columns full-width rather than clipped at 2). ADR-062 round-2: data widget now excludes employeeId (resolved via Related instead of raw uuid) and the height budget was corrected from the round-1 h7 (which clipped ~54 fields behind a scrollbar) to match content. Stat format uses 'number' not 'currency' because Payslip.currency varies per record (EUR/USD) and a widget's format is static. No files/calendar/comms leaves: nothing in the schema models an attachable payslip document or appointment, and Payslip carries no x-openregister-lifecycle so there are no lifecycleActions. Audit history is a sidebar tab.",
