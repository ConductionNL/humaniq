					{ "id": "ps-related", "type": "related", "title": "Related", "icon": "LinkVariant" },
					{ "id": "ps-data", "type": "data", "title": "Payslip breakdown", "icon": "TableColumn", "content": { "columns": 4, "exclude": ["employeeId"] } }
				],
				"layout": [
