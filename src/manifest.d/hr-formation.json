{
	"pages": [
		{
			"id": "FormatieplaatsDetail",
			"route": "/formation-places/:id",
			"type": "detail",
			"title": "Formation place",
			"config": {
				"register": "humaniq",
				"schema": "Formatieplaats",
				"_note": "people-formation-positions (2026-09-28): the data widget excludes orgUnitId/normfunctieId since Related resolves both; four stat tiles show this place's budgeted, filled, vacant and net FTE through endpointSource on GET /api/formation/occupancy?formatieplaatsId (computed on read, built-in widgets only per ADR-049); the object-list names the contracts that fill the place. No lifecycleActions: status is a plain enum.",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"widgets": [
					{
						"id": "data",
						"type": "data",
						"title": "Formation place",
						"icon": "AccountGroupOutline",
						"content": {
							"columns": 2,
							"exclude": [
								"orgUnitId",
								"normfunctieId"
							],
							"title": "Formation place"
						}
					},
					{
						"id": "related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant",
						"content": {
							"title": "Related"
						}
					},
					{
						"id": "occupancy-budgetedFte",
						"type": "stat",
						"title": "Budgeted FTE",
						"icon": "CalculatorVariantOutline",
						"content": {
							"label": "Budgeted FTE",
							"icon": "CalculatorVariantOutline",
							"format": {
								"style": "number",
								"decimals": 2
							},
							"endpointSource": {
								"url": "/apps/humaniq/api/formation/occupancy",
								"params": {
									"formatieplaatsId": "@objectId"
								}
							},
							"valueField": "total.budgetedFte"
						}
					},
					{
						"id": "occupancy-filledFte",
						"type": "stat",
						"title": "Filled FTE",
						"icon": "AccountCheckOutline",
						"content": {
							"label": "Filled FTE",
							"icon": "AccountCheckOutline",
							"format": {
								"style": "number",
								"decimals": 2
							},
							"endpointSource": {
								"url": "/apps/humaniq/api/formation/occupancy",
								"params": {
									"formatieplaatsId": "@objectId"
								}
							},
							"valueField": "total.filledFte"
						}
					},
					{
						"id": "occupancy-vacantFte",
						"type": "stat",
						"title": "Vacant FTE",
						"icon": "AccountQuestionOutline",
						"content": {
							"label": "Vacant FTE",
							"icon": "AccountQuestionOutline",
							"format": {
								"style": "number",
								"decimals": 2
							},
							"endpointSource": {
								"url": "/apps/humaniq/api/formation/occupancy",
								"params": {
									"formatieplaatsId": "@objectId"
								}
							},
							"valueField": "total.vacantFte"
						}
					},
					{
						"id": "occupancy-netFte",
						"type": "stat",
						"title": "Net FTE",
						"icon": "AccountClockOutline",
						"content": {
							"label": "Net FTE",
							"icon": "AccountClockOutline",
							"format": {
								"style": "number",
								"decimals": 2
							},
							"endpointSource": {
								"url": "/apps/humaniq/api/formation/occupancy",
								"params": {
									"formatieplaatsId": "@objectId"
								}
							},
							"valueField": "total.netFte"
						}
					},
					{
						"id": "object-list",
						"type": "object-list",
						"title": "Contracts on this place",
						"icon": "FileSign",
						"content": {
							"register": "humaniq",
							"schema": "EmploymentContract",
							"filter": {
								"formatieplaatsId": "@objectId"
							},
							"sort": {
								"field": "startDate",
								"dir": "desc"
							},
							"columns": [
								{
									"key": "employeeId",
									"label": "Employee"
								},
								{
									"key": "hoursPerWeek",
									"label": "Hours per week"
								},
								{
									"key": "startDate",
									"label": "Start"
								},
								{
									"key": "endDate",
									"label": "End"
								}
							],
							"limit": 25,
							"rowRoute": "EmploymentContractDetail",
							"viewAllRoute": "EmploymentContracts",
							"viewAllQuery": {
								"formatieplaatsId": "@objectId"
							},
							"emptyText": "No contract fills this place yet"
						}
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5
					},
					{
						"id": 2,
						"widgetId": "related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 5
					},
					{
						"id": 3,
						"widgetId": "occupancy-budgetedFte",
						"gridX": 0,
						"gridY": 5,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": 4,
						"widgetId": "occupancy-filledFte",
						"gridX": 3,
						"gridY": 5,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": 5,
						"widgetId": "occupancy-vacantFte",
						"gridX": 6,
						"gridY": 5,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": 6,
						"widgetId": "occupancy-netFte",
						"gridX": 9,
						"gridY": 5,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": 7,
						"widgetId": "object-list",
						"gridX": 0,
						"gridY": 7,
						"gridWidth": 12,
						"gridHeight": 4
					}
				]
			}
		}
	],
	"pageInstances": [
		{
			"templateRef": "indexScaffold",
			"register": "humaniq",
			"schema": "Formatieplaats",
			"params": {
				"id": "Formatieplaatsen",
				"route": "/formation-places",
				"title": "Formation places",
				"columns": [
					"title",
					"orgUnitId",
					"normfunctieId",
					"budgetedFte",
					"validFrom",
					"validUntil",
					"status"
				],
				"sort": {
					"field": "title",
					"order": "asc"
				},
				"filters": [
					"orgUnitId",
					"status"
				],
				"filter": {
					"administrationId": "@workspace.activeAdministrationId?"
				},
				"description": "Budgeted places per unit and function. Open a unit to see which are filled, vacant or overfilled, and the net FTE."
			}
		}
	]
}
