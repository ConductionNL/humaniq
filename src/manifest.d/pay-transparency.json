{
	"pages": [
		{
			"id": "PayTransparencyReport",
			"route": "/reports/pay-transparency",
			"type": "dashboard",
			"title": "Pay transparency",
			"_note": "reporting-pay-transparency REQ-PTR-001/002. The gender pay gap per pay category of equal work, from GET /api/reports/pay-transparency (HR and accountants of the active administration; anyone else gets 403 and an empty page). Hourly pay is the year's gross pay over hours paid; gaps are the men's figure minus the women's, as a percentage of the men's. A category with fewer women or men than app config pay_transparency_minimum_group (default 5) shows 'Too small to report' and no figure; the overall stats and quartiles stay empty when the whole administration is below it. The year filter's 'last' means the previous calendar year. The CSV header action always exports the previous calendar year: CnDashboardPage hands header actions no workspace context, so it cannot read the filter.",
			"config": {
				"description": "The gender pay gap in hourly pay, overall and per pay category, as the pay transparency law asks. Groups too small to keep people anonymous show no figures.",
				"pageFilters": [
					{
						"key": "payTransparencyYear",
						"label": "Year",
						"type": "select",
						"default": "last",
						"options": [
							{
								"value": "last",
								"label": "Last calendar year"
							},
							{
								"value": "2026",
								"label": "2026"
							},
							{
								"value": "2025",
								"label": "2025"
							},
							{
								"value": "2024",
								"label": "2024"
							}
						]
					}
				],
				"headerActions": [
					{
						"id": "export-pay-transparency",
						"label": "Download last year's report (CSV)",
						"type": "api-call",
						"icon": "DownloadOutline",
						"url": "/api/reports/pay-transparency/export",
						"method": "POST",
						"params": {},
						"download": true,
						"filename": "pay-transparency.csv",
						"errorMessage": "Downloading the pay transparency report failed."
					}
				],
				"widgets": [
					{
						"id": "pt-mean-gap",
						"title": "Mean gap (%)",
						"type": "stat",
						"icon": "ScaleBalance",
						"content": {
							"label": "Mean gap (%)",
							"caption": "Hourly pay, men minus women, of the men's",
							"icon": "ScaleBalance",
							"format": {
								"style": "decimal",
								"decimals": 1
							},
							"endpointSource": {
								"url": "/apps/humaniq/api/reports/pay-transparency",
								"params": {
									"year": "@workspace.payTransparencyYear?"
								}
							},
							"valueField": "overall.meanGap"
						}
					},
					{
						"id": "pt-median-gap",
						"title": "Median gap (%)",
						"type": "stat",
						"icon": "ScaleBalance",
						"content": {
							"label": "Median gap (%)",
							"caption": "Hourly pay, men minus women, of the men's",
							"icon": "ScaleBalance",
							"format": {
								"style": "decimal",
								"decimals": 1
							},
							"endpointSource": {
								"url": "/apps/humaniq/api/reports/pay-transparency",
								"params": {
									"year": "@workspace.payTransparencyYear?"
								}
							},
							"valueField": "overall.medianGap"
						}
					},
					{
						"id": "pt-variable-gap",
						"title": "Mean gap in variable pay (%)",
						"type": "stat",
						"icon": "ChartBar",
						"content": {
							"label": "Mean gap in variable pay (%)",
							"caption": "Among those who received variable pay",
							"icon": "ChartBar",
							"format": {
								"style": "decimal",
								"decimals": 1
							},
							"endpointSource": {
								"url": "/apps/humaniq/api/reports/pay-transparency",
								"params": {
									"year": "@workspace.payTransparencyYear?"
								}
							},
							"valueField": "overall.variableMeanGap"
						}
					},
					{
						"id": "pt-categories",
						"title": "Per pay category",
						"type": "object-table",
						"content": {
							"columns": [
								{
									"key": "name",
									"label": "Pay category",
									"cellClass": "cn-cell--strong"
								},
								{
									"key": "women",
									"label": "Women"
								},
								{
									"key": "men",
									"label": "Men"
								},
								{
									"key": "meanGapText",
									"label": "Mean gap"
								},
								{
									"key": "medianGapText",
									"label": "Median gap"
								},
								{
									"key": "variableMeanGapText",
									"label": "Gap in variable pay"
								}
							],
							"emptyText": "No payslips in this year",
							"endpointSource": {
								"url": "/apps/humaniq/api/reports/pay-transparency",
								"params": {
									"year": "@workspace.payTransparencyYear?"
								},
								"responsePath": "categories"
							}
						}
					},
					{
						"id": "pt-quartiles",
						"title": "Women and men per pay quartile (%)",
						"type": "object-table",
						"content": {
							"columns": [
								{
									"key": "quartile",
									"label": "Quartile"
								},
								{
									"key": "women",
									"label": "Women"
								},
								{
									"key": "men",
									"label": "Men"
								}
							],
							"emptyText": "Too small to report",
							"endpointSource": {
								"url": "/apps/humaniq/api/reports/pay-transparency",
								"params": {
									"year": "@workspace.payTransparencyYear?"
								},
								"responsePath": "quartiles"
							}
						}
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "pt-mean-gap",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2
					},
					{
						"id": 2,
						"widgetId": "pt-median-gap",
						"gridX": 4,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2
					},
					{
						"id": 3,
						"widgetId": "pt-variable-gap",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2
					},
					{
						"id": 4,
						"widgetId": "pt-categories",
						"gridX": 0,
						"gridY": 2,
						"gridWidth": 12,
						"gridHeight": 5
					},
					{
						"id": 5,
						"widgetId": "pt-quartiles",
						"gridX": 0,
						"gridY": 7,
						"gridWidth": 12,
						"gridHeight": 4
					}
				]
			}
		}
	]
}
