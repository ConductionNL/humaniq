{
	"pages": [
		{
			"id": "LoonbeslagDetail",
			"route": "/loonbeslagen/:id",
			"type": "detail",
			"title": "Wage garnishment",
			"config": {
				"register": "humaniq",
				"schema": "Loonbeslag",
				"_note": "loonbeslag (2026-07-15): the WkrAssessmentDetail stat-tile precedent -- three headline KPIs (ordered amount, beslagvrije voet, total claim) lead the page since that is the exposure question HR checks first, then the full record (creditor/dossierRef/status/effectiveFrom/effectiveTo/activated*/settled*/withdrawn*) in the lb-data widget below. No lifecycleActions: Loonbeslag.status carries no x-openregister-lifecycle (design.md D5) -- the admin/HR-gate-before-resolve check a lifecycle guard's (object, action, userId) contract cannot express, so all three transitions are guarded api-call actions against LoonbeslagController instead. The withdraw action's `reason` param is currently a fixed default string (the manifest v2 api-call action type has no free-text prompt collection) -- a prompt-collecting modal is a named fast-follow (README). Admin/HR only, mirroring the Payroll nav group. Audit history is a sidebar tab.",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"widgets": [
					{
						"id": "stat",
						"type": "stat",
						"title": "Ordered amount",
						"icon": "CashMinus",
						"content": {
							"label": "Ordered amount",
							"caption": "per period",
							"icon": "CashMinus",
							"valueColor": "#e9322d",
							"format": {
								"style": "number",
								"decimals": 2
							},
							"source": {
								"register": "humaniq",
								"schema": "Loonbeslag",
								"metric": "sum",
								"field": "orderedAmount",
								"filter": {
									"id": "@objectId"
								}
							}
						}
					},
					{
						"id": "stat-2",
						"type": "stat",
						"title": "Protected earnings floor",
						"icon": "ShieldCheckOutline",
						"content": {
							"label": "Protected earnings floor",
							"caption": "protected minimum",
							"icon": "ShieldCheckOutline",
							"valueColor": "#46ba61",
							"format": {
								"style": "number",
								"decimals": 2
							},
							"source": {
								"register": "humaniq",
								"schema": "Loonbeslag",
								"metric": "sum",
								"field": "beslagvrijeVoet",
								"filter": {
									"id": "@objectId"
								}
							}
						}
					},
					{
						"id": "stat-3",
						"type": "stat",
						"title": "Total claim",
						"icon": "CashMultiple",
						"content": {
							"label": "Total claim",
							"caption": "total garnishment",
							"icon": "CashMultiple",
							"valueColor": "#0082c9",
							"format": {
								"style": "number",
								"decimals": 2
							},
							"source": {
								"register": "humaniq",
								"schema": "Loonbeslag",
								"metric": "sum",
								"field": "totalClaim",
								"filter": {
									"id": "@objectId"
								}
							}
						}
					},
					{
						"id": "data",
						"type": "data",
						"title": "Wage garnishment",
						"icon": "Gavel",
						"content": {
							"columns": 2,
							"exclude": [
								"employeeId"
							],
							"title": "Wage garnishment"
						}
					},
					{
						"id": "related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant",
						"content": {
							"title": "Related"
						}
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "stat",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 3
					},
					{
						"id": 2,
						"widgetId": "stat-2",
						"gridX": 4,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 3
					},
					{
						"id": 3,
						"widgetId": "stat-3",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 3
					},
					{
						"id": 4,
						"widgetId": "data",
						"gridX": 0,
						"gridY": 3,
						"gridWidth": 8,
						"gridHeight": 12
					},
					{
						"id": 5,
						"widgetId": "related",
						"gridX": 8,
						"gridY": 3,
						"gridWidth": 4,
						"gridHeight": 12
					}
				],
				"headerActions": [
					{
						"id": "loonbeslag-activate",
						"label": "Verify and activate",
						"type": "api-call",
						"icon": "CheckCircleOutline",
						"url": "/api/loonbeslag/activate",
						"method": "POST",
						"params": {
							"loonbeslagId": "@objectId"
						},
						"confirm": true,
						"successMessage": "Wage garnishment verified and activated.",
						"errorMessage": "Activating the wage garnishment failed."
					},
					{
						"id": "loonbeslag-settle",
						"label": "Mark settled",
						"type": "api-call",
						"icon": "CashCheck",
						"url": "/api/loonbeslag/settle",
						"method": "POST",
						"params": {
							"loonbeslagId": "@objectId"
						},
						"confirm": true,
						"successMessage": "Wage garnishment marked as settled.",
						"errorMessage": "Marking as settled failed."
					},
					{
						"id": "loonbeslag-withdraw",
						"label": "Withdraw",
						"type": "api-call",
						"icon": "CloseCircleOutline",
						"url": "/api/loonbeslag/withdraw",
						"method": "POST",
						"params": {
							"loonbeslagId": "@objectId",
							"reason": "Ingetrokken door beheerder/HR via het beheerpaneel."
						},
						"confirm": true,
						"successMessage": "Wage garnishment withdrawn.",
						"errorMessage": "Withdrawing the wage garnishment failed."
					}
				]
			}
		}
	],
	"pageInstances": [
		{
			"templateRef": "indexScaffold",
			"register": "humaniq",
			"schema": "Loonbeslag",
			"params": {
				"id": "Loonbeslagen",
				"route": "/loonbeslagen",
				"title": "Wage garnishments",
				"columns": [
					"employeeId",
					"creditor",
					"dossierRef",
					"orderedAmount",
					"beslagvrijeVoet",
					"status",
					"effectiveFrom"
				],
				"sort": {
					"field": "effectiveFrom",
					"order": "desc"
				},
				"filters": [
					"status"
				],
				"description": "Wage garnishments ordered by a court or bailiff. The deduction is taken from net pay and never reduces it below the protected earnings floor. It is applied late in the payroll run, after settlement and any leave bought or sold. HR and administrators only: use the activate, settle and withdraw actions to change a garnishment.",
				"actions": [
					{
						"id": "create-loonbeslag",
						"label": "Register wage garnishment",
						"type": "open-form",
						"icon": "PlusCircleOutline",
						"register": "humaniq",
						"schema": "Loonbeslag",
						"onSuccessRoute": "LoonbeslagDetail",
						"successMessage": "Wage garnishment registered (status draft -- use Verify and activate to start deductions)."
					}
				]
			}
		}
	]
}
