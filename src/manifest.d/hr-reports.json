						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "4",
						"widgetId": "wage-gross-by-period",
						"gridX": 0,
						"gridY": 2,
						"gridWidth": 6,
						"gridHeight": 5,
						"showTitle": true
					},
					{
						"id": "5",
						"widgetId": "wage-employer-by-period",
						"gridX": 6,
						"gridY": 2,
						"gridWidth": 6,
						"gridHeight": 5,
						"showTitle": true
					},
					{
						"id": "6",
						"widgetId": "wage-tax-by-period",
						"gridX": 0,
						"gridY": 7,
						"gridWidth": 6,
						"gridHeight": 5,
						"showTitle": true
					},
					{
						"id": "7",
						"widgetId": "wage-net-by-period",
						"gridX": 6,
						"gridY": 7,
						"gridWidth": 6,
						"gridHeight": 5,
						"showTitle": true
					},
					{
						"id": "8",
						"widgetId": "wage-runs",
						"gridX": 0,
						"gridY": 12,
						"gridWidth": 12,
						"gridHeight": 6,
						"showTitle": true
					}
				]
			}
		},
