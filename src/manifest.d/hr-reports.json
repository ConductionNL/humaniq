		{
			"id": "TurnoverReport",
			"route": "/reports/turnover",
			"type": "dashboard",
			"title": "Turnover",
			"_note": "reporting-standard-reports-and-builder D1 (REQ-HRP-001). Starters and leavers per month are month buckets over Employee.startDate and endDate within the chosen range. Headcount is the plain record count, as on the workforce report: a headcount at the end of each month is a running total the aggregation endpoint cannot express, and a figure that means something else is worse than none.",
			"config": {
				"dateRange": {
					"enabled": true,
					"showHeaderPicker": true,
					"persistKey": "humaniq-turnover-range",
					"default": {
						"preset": "year"
					},
					"presets": [
						{
							"id": "quarter",
							"label": "Last 90 days",
							"days": 90
						},
						{
							"id": "year",
							"label": "Last 365 days",
							"days": 365
						},
						{
							"id": "two-years",
							"label": "Last two years",
							"days": 730
						}
					]
				},
				"widgets": [
					{
						"id": "stat-turnover-records",
						"title": "Employee records",
						"type": "stat",
						"content": {
							"label": "Employee records",
							"icon": "AccountGroupOutline",
							"route": {
								"name": "Employees"
							},
							"format": {
								"style": "decimal",
								"decimals": 0
							},
							"source": {
								"register": "humaniq",
								"schema": "Employee",
								"metric": "count"
							}
						}
					},
					{
						"id": "turnover-starters",
						"title": "Starters per month",
						"type": "chart",
						"content": {
							"chartKind": "bar",
							"legendPosition": "bottom",
							"emptyLabel": "No starters in this period",
							"dataSource": {
								"register": "humaniq",
								"schema": "Employee",
								"filter": {},
								"bucket": {
									"field": "startDate",
									"interval": "month",
									"metric": "count"
								}
							}
						}
					},
					{
						"id": "turnover-leavers",
						"title": "Leavers per month",
						"type": "chart",
						"content": {
							"chartKind": "bar",
							"legendPosition": "bottom",
							"emptyLabel": "No leavers in this period",
							"dataSource": {
								"register": "humaniq",
								"schema": "Employee",
								"filter": {},
								"bucket": {
									"field": "endDate",
									"interval": "month",
									"metric": "count"
								}
							}
						}
					},
					{
						"id": "turnover-end-reasons",
						"title": "Why employment ended",
						"type": "chart",
						"content": {
							"chartKind": "donut",
							"legendPosition": "bottom",
							"emptyLabel": "No leavers yet",
							"dataSource": {
								"register": "humaniq",
								"schema": "Employee",
								"aggregate": {
									"groupBy": "endReason",
									"metric": "count"
								}
							}
						}
					},
					{
						"id": "turnover-recent-leavers",
						"title": "Most recent leavers",
						"type": "object-table",
						"content": {
							"register": "humaniq",
							"schema": "Employee",
							"filter": {
								"endDate": "IS NOT NULL"
							},
							"sort": {
								"field": "endDate",
								"dir": "desc"
							},
							"limit": 8,
							"hideHeader": true,
							"emptyText": "No leavers yet",
							"viewAllRoute": {
								"name": "Employees"
							},
							"viewAllLabel": "View all employees",
							"columns": [
								{
									"key": "endDate",
									"label": "End date"
								},
								{
									"key": "lastName",
									"label": "Name"
								},
								{
									"key": "employeeNumber",
									"label": "Number"
								},
								{
									"key": "endReason",
									"label": "Reason"
								}
							]
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "stat-turnover-records",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2,
