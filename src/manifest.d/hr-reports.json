{
	"pages": [
		{
			"id": "WageCostReport",
			"route": "/reports/wage-costs",
			"type": "dashboard",
			"title": "Wage costs",
			"_note": "reporting-standard-reports-and-builder D1 (REQ-HRP-001). The wage cost per period and its components, summed from the stored PayrollRun totals with the aggregation endpoint's sum; nothing is recalculated here. A period is the run's own `period` string, so every run of a period adds up. The per-unit split stays on the department figures, which reach it through the trends endpoint.",
			"config": {
				"widgets": [
					{
						"id": "stat-wage-gross",
						"title": "Gross wages, all runs",
						"type": "stat",
						"content": {
							"label": "Gross wages, all runs",
							"icon": "CashMultiple",
							"route": {
								"name": "PayrollRuns"
							},
							"format": {
								"style": "currency",
								"currency": "EUR",
								"decimals": 0
							},
							"source": {
								"register": "humaniq",
								"schema": "PayrollRun",
								"metric": "sum",
								"field": "totalGross"
							}
						}
					},
					{
						"id": "stat-wage-employer",
						"title": "Employer charges, all runs",
						"type": "stat",
						"content": {
							"label": "Employer charges, all runs",
							"icon": "OfficeBuildingOutline",
							"route": {
								"name": "PayrollRuns"
							},
							"format": {
								"style": "currency",
								"currency": "EUR",
								"decimals": 0
							},
							"source": {
								"register": "humaniq",
								"schema": "PayrollRun",
								"metric": "sum",
								"field": "totalEmployerCharges"
							}
						}
					},
					{
						"id": "stat-wage-tax",
						"title": "Payroll tax, all runs",
						"type": "stat",
						"content": {
							"label": "Payroll tax, all runs",
							"icon": "Bank",
							"route": {
								"name": "PayrollRuns"
							},
							"format": {
								"style": "currency",
								"currency": "EUR",
								"decimals": 0
							},
							"source": {
								"register": "humaniq",
								"schema": "PayrollRun",
								"metric": "sum",
								"field": "totalLoonheffing"
							}
						}
					},
					{
						"id": "wage-gross-by-period",
						"title": "Gross wages per period",
						"type": "chart",
						"content": {
							"chartKind": "bar",
							"legendPosition": "bottom",
							"emptyLabel": "No payroll runs yet",
							"dataSource": {
								"register": "humaniq",
								"schema": "PayrollRun",
								"aggregate": {
									"groupBy": "period",
									"metric": "sum",
									"sumField": "totalGross"
								}
							}
						}
					},
					{
						"id": "wage-employer-by-period",
						"title": "Employer charges per period",
						"type": "chart",
						"content": {
							"chartKind": "bar",
							"legendPosition": "bottom",
							"emptyLabel": "No payroll runs yet",
							"dataSource": {
								"register": "humaniq",
								"schema": "PayrollRun",
								"aggregate": {
									"groupBy": "period",
									"metric": "sum",
									"sumField": "totalEmployerCharges"
								}
							}
						}
					},
					{
						"id": "wage-tax-by-period",
						"title": "Payroll tax per period",
						"type": "chart",
						"content": {
							"chartKind": "bar",
							"legendPosition": "bottom",
							"emptyLabel": "No payroll runs yet",
							"dataSource": {
								"register": "humaniq",
								"schema": "PayrollRun",
								"aggregate": {
									"groupBy": "period",
									"metric": "sum",
									"sumField": "totalLoonheffing"
								}
							}
						}
					},
					{
						"id": "wage-net-by-period",
						"title": "Net wages per period",
						"type": "chart",
						"content": {
							"chartKind": "bar",
							"legendPosition": "bottom",
							"emptyLabel": "No payroll runs yet",
							"dataSource": {
								"register": "humaniq",
								"schema": "PayrollRun",
								"aggregate": {
									"groupBy": "period",
									"metric": "sum",
									"sumField": "totalNet"
								}
							}
						}
					},
					{
						"id": "wage-runs",
						"title": "Costs per run",
						"type": "object-table",
						"content": {
							"register": "humaniq",
							"schema": "PayrollRun",
							"filter": {},
							"sort": {
								"field": "period",
								"dir": "desc"
							},
							"limit": 12,
							"hideHeader": true,
							"emptyText": "No payroll runs yet",
							"viewAllRoute": {
								"name": "PayrollRuns"
							},
							"viewAllLabel": "View all payroll runs",
							"columns": [
								{
									"key": "period",
									"label": "Period"
								},
								{
									"key": "totalGross",
									"label": "Gross"
								},
								{
									"key": "totalEmployerCharges",
									"label": "Employer charges"
								},
								{
									"key": "totalLoonheffing",
									"label": "Payroll tax"
								},
								{
									"key": "totalNet",
									"label": "Net"
								}
							]
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "stat-wage-gross",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "2",
