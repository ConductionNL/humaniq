{
	"pages": [
		{
			"id": "SickLeaveCaseDetail",
			"route": "/sick-leave/:id",
			"type": "detail",
			"title": "Sick leave case",
			"config": {
				"register": "humaniq",
				"schema": "SickLeaveCase",
				"_note": "leave-verzuim-mvp (2026-07-12): administrative-only sickness case -- NO medical/diagnosis data exists on this schema or its widgets (REQ-VWP-002). The 'Case' data widget (firstSickDay/recoveredDate/status/wachtdag/loondoorbetalingPercentage) excludes employeeId since Related already resolves and links the sick Employee by name; the 'Poortwachter milestones' widget surfaces all eight Due/Done WVP dates (probleemanalyse/plan van aanpak/UWV 42-wekenmelding/eerstejaarsevaluatie) so the re-integration clock is the page's second headline fact. Files is labeled and described for gespreksverslagen & plan-van-aanpak process documents ONLY -- repeating the no-medical-data warning, matching the schema's own privacy stance. lifecycleActions expose exactly herstellen/heropenen (gemeld<->hersteld) -- no invented edges. Audit history is a sidebar tab. absence-deadlines-and-signals (2026-09-28): each milestone shows its days left (a materialised calculation the reminder rules watch); the 'Generate 42-week notification' api-call posts to POST /api/sick-leave/{id}/uwv-notification (UwvNotificationController, HR or admin only), which files the rendered document as an HrGeneratedDocument on the case. Nothing is sent to UWV.",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"widgets": [
					{
						"id": "data",
						"type": "data",
						"title": "Case",
						"icon": "EmoticonSickOutline",
						"content": {
							"columns": 2,
							"exclude": [
								"employeeId",
								"probleemanalyseDue",
								"probleemanalyseDone",
								"planVanAanpakDue",
								"planVanAanpakDone",
								"uwv42WeekMeldingDue",
								"uwv42WeekMeldingDone",
								"eerstejaarsevaluatieDue",
								"eerstejaarsevaluatieDone",
								"currentAbsencePercentage",
								"absenceProgression",
								"probleemanalyseDaysLeft",
								"planVanAanpakDaysLeft",
								"uwv42WeekMeldingDaysLeft",
								"eerstejaarsevaluatieDaysLeft"
							],
							"title": "Case"
						}
					},
					{
						"id": "data-2",
						"type": "data",
						"title": "Poortwachter milestones",
						"icon": "CalendarClock",
						"content": {
							"columns": 2,
							"include": [
								"probleemanalyseDue",
								"probleemanalyseDaysLeft",
								"probleemanalyseDone",
								"planVanAanpakDue",
								"planVanAanpakDaysLeft",
								"planVanAanpakDone",
								"uwv42WeekMeldingDue",
								"uwv42WeekMeldingDaysLeft",
								"uwv42WeekMeldingDone",
								"eerstejaarsevaluatieDue",
								"eerstejaarsevaluatieDaysLeft",
								"eerstejaarsevaluatieDone"
							],
							"title": "Poortwachter milestones"
						}
					},
					{
						"id": "related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant",
						"content": {
							"title": "Related"
						}
					},
					{
						"id": "data-3",
						"type": "data",
						"title": "Work resumption",
						"icon": "Timeline",
						"content": {
							"columns": 1,
							"include": [
								"currentAbsencePercentage",
								"absenceProgression"
							],
							"title": "Work resumption"
						}
					},
					{
						"id": "files",
						"type": "files",
						"title": "Case notes & action plan",
						"icon": "FolderOutline"
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5
					},
					{
						"id": 2,
						"widgetId": "data-2",
						"gridX": 0,
						"gridY": 5,
						"gridWidth": 8,
						"gridHeight": 8
					},
					{
						"id": 3,
						"widgetId": "related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 13
					},
					{
						"id": 4,
						"widgetId": "data-3",
						"gridX": 0,
						"gridY": 13,
						"gridWidth": 12,
						"gridHeight": 3
					},
					{
						"id": 5,
						"widgetId": "files",
						"gridX": 0,
						"gridY": 16,
						"gridWidth": 12,
						"gridHeight": 4
					}
				],
				"lifecycleActions": {
					"field": "status",
					"transitions": [
						{
							"action": "herstellen",
							"from": [
								"gemeld"
							],
							"to": "hersteld",
							"label": "Mark recovered"
						},
						{
							"action": "heropenen",
							"from": [
								"hersteld"
							],
							"to": "gemeld",
							"label": "Reopen"
						}
					]
				},
				"headerActions": [
					{
						"id": "generate-uwv-42",
						"label": "Generate 42-week notification",
						"type": "api-call",
						"icon": "FileSendOutline",
						"url": "/api/sick-leave/{objectId}/uwv-notification",
						"method": "POST",
						"confirm": true,
						"successMessage": "The 42-week notification is on the case. Submit it to UWV and fill in the date it was done.",
						"errorMessage": "The 42-week notification could not be made."
					}
				]
			}
		}
	],
	"pageInstances": [
		{
			"templateRef": "indexScaffold",
			"register": "humaniq",
			"schema": "SickLeaveCase",
			"params": {
				"id": "SickLeaveCases",
				"route": "/sick-leave",
				"title": "Sick leave cases",
				"columns": [
					"employeeId",
					"firstSickDay",
					"recoveredDate",
					"status"
				],
				"sort": {
					"field": "firstSickDay",
					"order": "desc"
				},
				"filters": [
					"status"
				],
				"filter": {
					"administrationId": "@workspace.activeAdministrationId?"
				},
				"description": "Sick leave cases and the Gatekeeper Improvement Act milestones (administrative data, no medical data)."
			}
		}
	]
}
