	"pageInstances": [
		{
			"templateRef": "indexScaffold",
			"register": "hrmq",
			"schema": "Onboarding",
			"params": {
				"id": "Onboardings",
				"route": "/onboardings",
				"title": "Onboardings",
				"columns": [
					"employeeId",
					"status",
					"startDate",
					"proeftijdEndDate"
				],
				"sort": {
					"field": "startDate",
					"order": "desc"
				},
				"filters": [
					"status"
				],
				"filter": {
					"administrationId": "@workspace.activeAdministrationId?"
				},
				"description": "Onboardingcases per nieuwe medewerker: contract, WID-check, BSN/IBAN, IT-provisioning en pensioenaanmelding, met de proeftijd- en startdatum als klok."
			}
		},
		{
			"templateRef": "indexScaffold",
			"register": "hrmq",
			"schema": "Offboarding",
			"params": {
				"id": "Offboardings",
				"route": "/offboardings",
				"title": "Offboardings",
				"columns": [
					"employeeId",
					"reason",
					"status",
					"lastWorkingDay"
				],
				"sort": {
					"field": "lastWorkingDay",
					"order": "desc"
				},
				"filters": [
