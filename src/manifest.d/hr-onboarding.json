{
	"pages": [
		{
			"id": "OnboardingDetail",
			"route": "/onboardings/:id",
			"type": "detail",
			"title": "Onboarding",
			"config": {
				"register": "hrmq",
				"schema": "Onboarding",
				"_note": "onboarding-wizard-mvp (2026-07-13): the 'Case' widget excludes employeeId (Related resolves the hired Employee) and the six checklist gate fields, leaving startDate/proeftijdEndDate/status; the 'Checklist' widget groups exactly the six gate booleans plus widCheckDate and notes -- the SickLeaveCaseDetail grouped-data pattern. lifecycleActions expose exactly the REQ-OBW-002 edges (contract_bevestigen/gegevens_valideren/gereed_melden/starten/afronden/annuleren) -- no invented edges. Checklist gates are audit-enforced (lib/Standards/Checks/NlOnboardingChecks.php), NOT write-time guards: no transition here blocks on an unmet checklist field -- guard wiring for compliance-checked schemas is owned by the active hrmq-rule-compliance-enforcement change (design.md D2). Audit history is a sidebar tab.",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"widgets": [
					{
						"id": "data",
						"type": "data",
						"title": "Case",
						"icon": "AccountPlus",
						"content": {
							"columns": 2,
							"exclude": [
								"employeeId",
								"contractSigned",
								"widCheckDone",
								"widCheckDate",
								"bsnValidated",
								"ibanVerified",
								"itProvisioned",
								"pensioenAangemeld",
								"notes"
							],
							"title": "Case"
						}
					},
					{
						"id": "data-2",
						"type": "data",
						"title": "Checklist",
						"icon": "CheckDecagramOutline",
						"content": {
							"columns": 2,
							"include": [
								"contractSigned",
								"widCheckDone",
								"widCheckDate",
								"bsnValidated",
								"ibanVerified",
								"itProvisioned",
								"pensioenAangemeld",
								"notes"
							],
							"title": "Checklist"
						}
					},
					{
						"id": "related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant",
						"content": {
							"title": "Related"
						}
					},
					{
						"id": "files",
						"type": "files",
						"title": "Contract & WID-documenten",
						"icon": "FolderOutline"
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5
					},
					{
						"id": 2,
						"widgetId": "data-2",
						"gridX": 0,
						"gridY": 5,
						"gridWidth": 8,
						"gridHeight": 8
					},
					{
						"id": 3,
						"widgetId": "related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 13
					},
					{
						"id": 4,
						"widgetId": "files",
						"gridX": 0,
						"gridY": 13,
						"gridWidth": 12,
						"gridHeight": 4
					}
				],
				"lifecycleActions": {
					"field": "status",
					"transitions": [
						{
							"action": "contract_bevestigen",
							"from": [
								"aangenomen"
							],
							"to": "contract_getekend",
							"label": "Contract bevestigen"
						},
						{
							"action": "gegevens_valideren",
							"from": [
								"contract_getekend"
							],
							"to": "gegevens_gevalideerd",
							"label": "Gegevens valideren"
						},
						{
							"action": "gereed_melden",
							"from": [
								"gegevens_gevalideerd"
							],
							"to": "gereed_eerste_werkdag",
							"label": "Gereed melden"
						},
						{
							"action": "starten",
							"from": [
								"gereed_eerste_werkdag"
							],
							"to": "proeftijd_lopend",
							"label": "Starten"
						},
						{
							"action": "afronden",
							"from": [
								"proeftijd_lopend"
							],
							"to": "afgerond",
							"label": "Afronden"
						},
						{
							"action": "annuleren",
							"from": [
								"aangenomen",
								"contract_getekend",
								"gegevens_gevalideerd",
								"gereed_eerste_werkdag",
								"proeftijd_lopend"
							],
							"to": "geannuleerd",
							"label": "Annuleren"
						}
					]
				}
			}
		},
