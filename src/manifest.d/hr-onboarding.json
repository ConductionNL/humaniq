{
	"pages": [
		{
			"id": "OnboardingDetail",
			"route": "/onboardings/:id",
			"type": "detail",
			"title": "Onboarding",
			"config": {
				"register": "humaniq",
				"schema": "Onboarding",
				"_note": "onboarding-wizard-mvp (2026-07-13): the 'Case' widget excludes employeeId (Related resolves the hired Employee) and the six checklist gate fields, leaving startDate/proeftijdEndDate/status; the 'Checklist' widget groups exactly the six gate booleans plus widCheckDate and notes -- the SickLeaveCaseDetail grouped-data pattern. lifecycleActions expose exactly the REQ-OBW-002 edges (contract_bevestigen/gegevens_valideren/gereed_melden/starten/afronden/annuleren) -- no invented edges. Checklist gates are audit-enforced (lib/Standards/Checks/NlOnboardingChecks.php), except the right-to-work check: people-dossier-completeness (2026-09-29) adds RightToWorkGuard on gereed_melden and starten (REQ-DCP-004) and a Right-to-work checks object-list (RightToWorkCheck.onboardingId = @objectId) where HR records the check; a pass ticks widCheckDone. Audit history is a sidebar tab.",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"widgets": [
					{
						"id": "data",
						"type": "data",
						"title": "Case",
						"icon": "AccountPlus",
						"content": {
							"columns": 2,
							"exclude": [
								"employeeId",
								"contractSigned",
								"widCheckDone",
								"widCheckDate",
								"bsnValidated",
								"ibanVerified",
								"itProvisioned",
								"pensioenAangemeld",
								"notes"
							],
							"title": "Case"
						}
					},
					{
						"id": "data-2",
						"type": "data",
						"title": "Checklist",
						"icon": "CheckDecagramOutline",
						"content": {
							"columns": 2,
							"include": [
								"contractSigned",
								"widCheckDone",
								"widCheckDate",
								"bsnValidated",
								"ibanVerified",
								"itProvisioned",
								"pensioenAangemeld",
								"notes"
							],
							"title": "Checklist"
						}
					},
					{
						"id": "related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant",
						"content": {
							"title": "Related"
						}
					},
					{
						"id": "files",
						"type": "files",
						"title": "Contract & ID documents",
						"icon": "FolderOutline"
					},
					{
						"id": "object-list",
						"type": "object-list",
						"title": "Right-to-work checks",
						"icon": "ShieldCheckOutline",
						"content": {
							"register": "humaniq",
							"schema": "RightToWorkCheck",
							"filter": {
								"onboardingId": "@objectId"
							},
							"sort": {
								"field": "checkedOn",
								"dir": "desc"
							},
							"columns": [
								{
									"key": "documentType",
									"label": "Document"
								},
								{
									"key": "result",
									"label": "Result"
								},
								{
									"key": "reason",
									"label": "Reason"
								},
								{
									"key": "checkedOn",
									"label": "Checked on"
								}
							],
							"limit": 10,
							"rowRoute": "RightToWorkCheckDetail",
							"viewAllRoute": "RightToWorkChecks",
							"viewAllQuery": {
								"onboardingId": "@objectId"
							},
							"emptyText": "No right-to-work check yet. Mark ready is refused until one passes."
						}
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5
					},
					{
						"id": 2,
						"widgetId": "data-2",
						"gridX": 0,
						"gridY": 5,
						"gridWidth": 8,
						"gridHeight": 8
					},
					{
						"id": 3,
						"widgetId": "related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 13
					},
					{
						"id": 4,
						"widgetId": "files",
						"gridX": 0,
						"gridY": 17,
						"gridWidth": 12,
						"gridHeight": 4
					},
					{
						"id": 5,
						"widgetId": "object-list",
						"gridX": 0,
						"gridY": 13,
						"gridWidth": 12,
						"gridHeight": 4
					}
				],
				"lifecycleActions": {
					"field": "status",
					"transitions": [
						{
							"action": "contract_bevestigen",
							"from": [
								"aangenomen"
							],
							"to": "contract_getekend",
							"label": "Confirm contract"
						},
						{
							"action": "gegevens_valideren",
							"from": [
								"contract_getekend"
							],
							"to": "gegevens_gevalideerd",
							"label": "Validate data"
						},
						{
							"action": "gereed_melden",
							"from": [
								"gegevens_gevalideerd"
							],
							"to": "gereed_eerste_werkdag",
							"label": "Mark ready"
						},
						{
							"action": "starten",
							"from": [
								"gereed_eerste_werkdag"
							],
							"to": "proeftijd_lopend",
							"label": "Start"
						},
						{
							"action": "afronden",
							"from": [
								"proeftijd_lopend"
							],
							"to": "afgerond",
							"label": "Complete"
						},
						{
							"action": "annuleren",
							"from": [
								"aangenomen",
								"contract_getekend",
								"gegevens_gevalideerd",
								"gereed_eerste_werkdag",
								"proeftijd_lopend"
							],
							"to": "geannuleerd",
							"label": "Cancel"
						}
					]
				}
			}
		},
		{
			"id": "OffboardingDetail",
			"route": "/offboardings/:id",
			"type": "detail",
			"title": "Offboarding",
			"config": {
				"register": "humaniq",
				"schema": "Offboarding",
				"_note": "offboarding-wizard-mvp (2026-07-13): the 'Case' widget excludes employeeId (Related resolves the departing Employee), the checklist/eindafrekening fields and notes, leaving reason/status/lastWorkingDay; the 'Checklist' widget groups exitGesprekDone/assetsIngeleverd/toegangIngetrokken; the 'Eindafrekening' widget groups verlofsaldoUitbetaald/vakantiegeldAfgerekend/transitievergoedingBedrag/getuigschriftVerstrekt/notes -- the OnboardingDetail grouped-data pattern. lifecycleActions expose exactly the REQ-OFB-002 edges (afronding_plannen/eindafrekening_gereedmelden/afronden/annuleren) -- no invented edges. Checklist/eindafrekening gates are audit-enforced (lib/Standards/Checks/NlOffboardingChecks.php), NOT write-time guards: no transition here blocks on an unmet gate field -- guard wiring for compliance-checked schemas is owned by the active humaniq-rule-compliance-enforcement change (design.md D2). Audit history is a sidebar tab. hiring-offboarding-completion (2026-09-30): Revoke access disables the leaver's Nextcloud account (Employee.nextcloudUserId) through Nextcloud's user manager, refuses an administrator or the caller's own account, and stamps who and when (HR or admin; 404 before 403). Calculate transition payment (HR, payroll or admin) writes transitievergoedingBedrag and the breakdown from the contract chain, the monthly wage and the 2026 cap in the nl-offboarding-transitievergoeding rule; the amount stays editable. Exit interview lists the case's ExitInterview; recording one fills in exitGesprekDone.",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"widgets": [
					{
						"id": "data",
						"type": "data",
						"title": "Case",
						"icon": "AccountMinus",
						"content": {
							"columns": 2,
							"exclude": [
								"employeeId",
								"exitGesprekDone",
								"assetsIngeleverd",
								"toegangIngetrokken",
								"verlofsaldoUitbetaald",
								"vakantiegeldAfgerekend",
								"transitievergoedingBedrag",
								"getuigschriftVerstrekt",
								"notes",
								"toegangIngetrokkenDoor",
								"toegangIngetrokkenOp",
								"toegangIngetrokkenToelichting",
								"transitievergoedingBerekening"
							],
							"title": "Case"
						}
					},
					{
						"id": "data-2",
						"type": "data",
						"title": "Checklist",
						"icon": "CheckDecagramOutline",
						"content": {
							"columns": 2,
							"include": [
								"exitGesprekDone",
								"assetsIngeleverd",
								"toegangIngetrokken",
								"toegangIngetrokkenDoor",
								"toegangIngetrokkenOp",
								"toegangIngetrokkenToelichting"
							],
							"title": "Checklist"
						}
					},
					{
						"id": "data-3",
						"type": "data",
						"title": "Final settlement",
						"icon": "ReceiptTextOutline",
						"content": {
							"columns": 2,
							"include": [
								"verlofsaldoUitbetaald",
								"vakantiegeldAfgerekend",
								"transitievergoedingBedrag",
								"transitievergoedingBerekening",
								"getuigschriftVerstrekt",
								"notes"
							],
							"title": "Final settlement"
						}
					},
					{
						"id": "exit-interviews",
						"type": "object-list",
						"title": "Exit interview",
						"icon": "CommentAccountOutline",
						"content": {
							"register": "humaniq",
							"schema": "ExitInterview",
							"filter": {
								"offboardingId": "@objectId"
							},
							"sort": {
								"field": "heldOn",
								"dir": "desc"
							},
							"columns": [
								{
									"key": "heldOn",
									"label": "Held on"
								},
								{
									"key": "mainReason",
									"label": "Main reason"
								},
								{
									"key": "wouldRecommend",
									"label": "Would recommend"
								},
								{
									"key": "wouldReturn",
									"label": "Would come back"
								}
							],
							"limit": 5,
							"rowRoute": "ExitInterviewDetail",
							"viewAllRoute": "ExitInterviews",
							"emptyText": "No exit interview recorded yet"
						}
					},
					{
						"id": "related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant",
						"content": {
							"title": "Related"
						}
					},
					{
						"id": "files",
						"type": "files",
						"title": "Settlement agreement & reference documents",
						"icon": "FolderOutline"
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5
					},
					{
						"id": 2,
						"widgetId": "data-2",
						"gridX": 0,
						"gridY": 5,
						"gridWidth": 8,
						"gridHeight": 6
					},
					{
						"id": 3,
						"widgetId": "data-3",
						"gridX": 0,
						"gridY": 11,
						"gridWidth": 8,
						"gridHeight": 8
					},
					{
						"id": 6,
						"widgetId": "exit-interviews",
						"gridX": 0,
						"gridY": 19,
						"gridWidth": 8,
						"gridHeight": 4
					},
					{
						"id": 4,
						"widgetId": "related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 23
					},
					{
						"id": 5,
						"widgetId": "files",
						"gridX": 0,
						"gridY": 23,
						"gridWidth": 12,
						"gridHeight": 4
					}
				],
				"lifecycleActions": {
					"field": "status",
					"transitions": [
						{
							"action": "afronding_plannen",
							"from": [
								"aangekondigd"
							],
							"to": "afronding_gepland",
							"label": "Plan completion"
						},
						{
							"action": "eindafrekening_gereedmelden",
							"from": [
								"afronding_gepland"
							],
							"to": "eindafrekening_gereed",
							"label": "Mark final settlement ready"
						},
						{
							"action": "afronden",
							"from": [
								"eindafrekening_gereed"
							],
							"to": "afgerond",
							"label": "Complete"
						},
						{
							"action": "annuleren",
							"from": [
								"aangekondigd",
								"afronding_gepland",
								"eindafrekening_gereed"
							],
							"to": "geannuleerd",
							"label": "Cancel"
						}
					]
				},
				"headerActions": [
					{
						"id": "revoke-access",
						"label": "Revoke access",
						"type": "api-call",
						"icon": "AccountCancelOutline",
						"url": "/api/offboarding/@objectId/revoke-access",
						"method": "POST",
						"confirm": true
					},
					{
						"id": "transition-payment",
						"label": "Calculate transition payment",
						"type": "api-call",
						"icon": "Calculator",
						"url": "/api/offboarding/@objectId/transition-payment",
						"method": "POST",
						"confirm": true
					}
				]
			}
		},
		{
			"id": "ExitInterviews",
			"route": "/exit-interviews",
			"type": "dashboard",
			"title": "Exit interviews",
			"config": {
				"description": "What leavers said when they left, and their reasons counted over the last twelve months.",
				"_note": "hiring-offboarding-completion (2026-09-30): REQ-OFC-001/002. The reason count reads GET /api/offboarding/exit-reasons (HR only; anonymised interviews count too, they keep reason, department and date). The list reads the ExitInterview objects; OpenRegister lets only humaniq-hr read them. The disabled flow Exit interviews anonymiseren clears the person link and free text after 90 days once an administrator enables it.",
				"widgets": [
					{
						"id": "exit-reasons",
						"type": "chart",
						"title": "Reasons for leaving, last twelve months",
						"content": {
							"type": "bar",
							"height": "100%",
							"endpointSource": {
								"url": "/apps/humaniq/api/offboarding/exit-reasons",
								"params": {
									"months": 12
								},
								"responsePath": "reasons"
							},
							"labelsPath": "label",
							"seriesFields": [
								{
									"name": "Leavers",
									"path": "count"
								}
							],
							"emptyLabel": "No exit interviews in the last twelve months"
						}
					},
					{
						"id": "exit-list",
						"type": "object-table",
						"title": "Exit interviews",
						"content": {
							"register": "humaniq",
							"schema": "ExitInterview",
							"filter": {
								"administrationId": "@workspace.activeAdministrationId?"
							},
							"sort": {
								"field": "heldOn",
								"dir": "desc"
							},
							"limit": 50,
							"columns": [
								"heldOn",
								"mainReason",
								"wouldRecommend",
								"wouldReturn",
								"orgUnitId",
								"anonymisedAt"
							],
							"rowRoute": "ExitInterviewDetail",
							"emptyText": "No exit interviews yet"
						}
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "exit-reasons",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 5
					},
					{
						"id": 2,
						"widgetId": "exit-list",
						"gridX": 0,
						"gridY": 5,
						"gridWidth": 12,
						"gridHeight": 7
					}
				]
			}
		}
	],
	"pageInstances": [
		{
			"templateRef": "indexScaffold",
			"register": "humaniq",
			"schema": "Onboarding",
			"params": {
				"id": "Onboardings",
				"route": "/onboardings",
				"title": "Onboardings",
				"columns": [
					"employeeId",
					"status",
					"startDate",
					"proeftijdEndDate"
				],
				"sort": {
					"field": "startDate",
					"order": "desc"
				},
				"filters": [
					"status"
				],
				"filter": {
					"administrationId": "@workspace.activeAdministrationId?"
				},
				"description": "Onboarding cases per new employee: contract, ID verification, BSN/IBAN, IT provisioning and pension registration, with the probation and start date as the clock."
			}
		},
		{
			"templateRef": "indexScaffold",
			"register": "humaniq",
			"schema": "Offboarding",
			"params": {
				"id": "Offboardings",
				"route": "/offboardings",
				"title": "Offboardings",
				"columns": [
					"employeeId",
					"reason",
					"status",
					"lastWorkingDay"
				],
				"sort": {
					"field": "lastWorkingDay",
					"order": "desc"
				},
				"filters": [
					"status",
					"reason"
				],
				"description": "Offboarding cases per departing employee: exit interview, return of company property, access revocation and the final settlement (leave balance, holiday allowance, transition payment, reference letter), with the last working day as the clock."
			}
		},
		{
			"templateRef": "simpleDetailScaffold",
			"register": "humaniq",
			"schema": "ExitInterview",
			"params": {
				"id": "ExitInterviewDetail",
				"route": "/exit-interviews/:id",
				"title": "Exit interview",
				"dataTitle": "Exit interview",
				"dataIcon": "CommentAccountOutline",
				"relatedTitle": "Related",
				"gridHeight": 8,
				"overrides": {
					"anonymisedAt": {
						"editable": false
					},
					"administrationId": {
						"editable": false
					}
				},
				"note": "hiring-offboarding-completion (2026-09-30): D1. Recording the interview fills in the case's exit interview date, the leaver and the department (ExitInterviewListener). After 90 days the flow clears the leaver, the case, who held it and the free text."
			}
		}
	]
}
