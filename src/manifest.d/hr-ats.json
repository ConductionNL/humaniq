									"label": "Criterion",
									"cellClass": "cn-cell--strong"
								},
								{
									"key": "average",
									"label": "Average"
								},
								{
									"key": "count",
									"label": "Scores"
								}
							],
							"emptyText": "No scores yet."
						}
					}
				],
