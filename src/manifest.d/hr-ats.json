			"id": "VacancyDetail",
			"route": "/vacancies/:id",
			"title": "Vacancy",
			"type": "detail"
		},
		{
			"id": "MijnAanbevelingen",
			"route": "/mijn/aanbevelingen",
			"type": "index",
			"title": "My referrals",
			"config": {
				"register": "humaniq",
				"schema": "Referral",
				"_note": "hiring-candidate-assessment D4: the employee's own referrals. The server stamps referrerUserId, refuses a referral without the candidate's agreement or for a vacancy that is not published, creates the application and keeps status in step with it; includeFields is the allowlist of what the referrer types.",
				"description": "Put someone forward for a published vacancy and follow where their application stands. Open vacancies lists what we are hiring for.",
				"filter": {
					"referrerUserId": "@me"
				},
				"columns": [
					"candidateName",
					"vacancyTitle",
					"status"
				],
				"sort": {
					"field": "candidateName",
					"order": "asc"
				},
				"actionToggles": {
					"showAdd": true
				},
				"includeFields": [
					"vacancyId",
					"candidateName",
					"email",
					"phone",
					"motivation",
					"candidateConsented"
				]
			}
		}
	],
	"pageInstances": [
		{
			"templateRef": "indexScaffold",
			"register": "humaniq",
			"schema": "Vacancy",
			"params": {
				"id": "Vacancies",
				"route": "/vacancies",
				"title": "Vacancies",
				"columns": [
					"title",
					"department",
					"status",
					"publishedDate",
					"closingDate"
				],
				"sort": {
					"field": "publishedDate",
					"order": "desc"
				},
				"filters": [
					"status",
					"department"
				],
				"filter": {
					"administrationId": "@workspace.activeAdministrationId?"
				},
				"description": "Vacancies: draft, published, closed. Published vacancies appear on the careers page of the portal, where candidates apply."
			}
		},
		{
			"templateRef": "indexScaffold",
			"register": "humaniq",
			"schema": "job-application",
			"params": {
				"id": "Applications",
				"route": "/applications",
				"title": "Applications",
				"columns": [
					"candidateName",
					"vacancyId",
					"status",
					"talentPoolOptIn",
					"retentionExpiryDate"
				],
				"sort": {
					"field": "candidateName",
					"order": "asc"
				},
				"filters": [
					"status"
				],
				"filter": {
					"administrationId": "@workspace.activeAdministrationId?"
				},
				"description": "Applications as they move from new, through screening, interview and offer, to hired or rejected. Filter by status to see one stage at a time."
			}
		},
		{
			"templateRef": "indexScaffold",
			"register": "humaniq",
			"schema": "Interview",
			"params": {
				"id": "Interviews",
				"route": "/interviews",
				"title": "Interviews",
				"columns": [
					"applicationId",
					"scheduledStart",
					"scheduledEnd",
					"mode",
					"status"
				],
				"sort": {
					"field": "scheduledStart",
					"order": "desc"
				},
				"filters": [
					"status",
					"mode"
				],
				"description": "interview-scheduling: scheduled, completed and cancelled job interviews. An interview is synced to the shared calendar through the InterviewDetail page or 'occ humaniq:interview:sync' (design D1/D6)."
			}
		},
		{
			"templateRef": "simpleDetailScaffold",
			"register": "humaniq",
			"schema": "Interview",
			"params": {
				"id": "InterviewDetail",
				"route": "/interviews/:id",
				"title": "Interview",
				"dataTitle": "Interview",
				"dataIcon": "CalendarAccountOutline",
				"relatedTitle": "Related",
				"gridHeight": 6,
				"note": "interview-scheduling (2026-07-16): one interview round (gesprek) for an Application -- a SEPARATE schema, not fields on Application, because one Application can have multiple interview rounds each with its own lifecycle/calendarEventUid (design.md D2). The 'Interview' data widget excludes applicationId (Related resolves the Application) and calendarEventUid stays visible as the system-managed idempotency marker (design.md D3) -- an inspectable 'has this ever reached the calendar' signal, never user-editable. lifecycleActions expose exactly voltooien/annuleren (design D2) -- no invented edges; rescheduling is a plain field update to scheduledStart/scheduledEnd, not a status transition. The page-level 'Sync naar agenda' api-call action mirrors ApplicationDetail's 'request-offer-signature' shape -- POST /api/interviews/sync with {interviewId: @objectId}, guarded server-side by InterviewController::authorizeInterview() (resolve-first RBAC) + isAdminOrHr(). No files widget -- the schema carries no document/retention field. Audit history is a sidebar tab.",
				"exclude": [
					"applicationId"
				],
				"headerActions": [
					{
						"id": "sync-to-calendar",
						"label": "Sync to calendar",
						"type": "api-call",
						"icon": "CalendarSyncOutline",
						"url": "/api/interviews/sync",
						"method": "POST",
						"params": {
							"interviewId": "@objectId"
						},
						"confirm": true,
						"successMessage": "Interview synced to the shared calendar.",
						"errorMessage": "Syncing to the calendar failed."
					}
				],
				"lifecycleActions": {
					"field": "status",
					"transitions": [
						{
							"action": "voltooien",
							"from": [
								"scheduled"
							],
							"to": "completed",
							"label": "Complete"
						},
						{
							"action": "annuleren",
							"from": [
								"scheduled"
							],
							"to": "cancelled",
							"label": "Cancel"
						}
					]
				}
			}
		}
	]
}
